					<ProtectedString name="Source"><![CDATA[--!strict
-- Utils: low-level, stateless helper functions shared by every scanner.
local Utils = {}

function Utils.splitLines(text)
	local results = {}
	for line in string.gmatch(text, "[^\r\n]+") do
		local trimmed = line:match("^%s*(.-)%s*$")
		if trimmed and trimmed ~= "" then
			table.insert(results, trimmed)
		end
	end
	return results
end

function Utils.escapeLuaString(value)
	return string.format("%q", value)
end

function Utils.isLuaScript(obj)
	return obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")
end

function Utils.isAttributeScannable(obj)
	return obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript")
		or obj:IsA("Model") or obj:IsA("Part") or obj:IsA("MeshPart")
		or obj:IsA("UnionOperation") or obj:IsA("SpecialMesh") or obj:IsA("Folder")
		or obj:IsA("Tool") or obj:IsA("Accessory") or obj:IsA("Humanoid")
		or obj:IsA("Animation") or obj:IsA("StringValue") or obj:IsA("NumberValue")
		or obj:IsA("BoolValue") or obj:IsA("ObjectValue")
end

function Utils.isTextUIObject(obj)
	return obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")
		or obj:IsA("StringValue") or obj:IsA("ProximityPrompt")
		or obj:IsA("Dialog") or obj:IsA("DialogChoice")
end

function Utils.getScannableTexts(obj)
	local texts = {}
	if obj:IsA("TextLabel") or obj:IsA("TextButton") then
		table.insert(texts, obj.Text)
	elseif obj:IsA("TextBox") then
		table.insert(texts, obj.Text)
		table.insert(texts, obj.PlaceholderText)
	elseif obj:IsA("StringValue") then
		table.insert(texts, obj.Value)
	elseif obj:IsA("ProximityPrompt") then
		table.insert(texts, obj.ActionText)
		table.insert(texts, obj.ObjectText)
	elseif obj:IsA("Dialog") then
		table.insert(texts, obj.InitialPrompt)
	elseif obj:IsA("DialogChoice") then
		table.insert(texts, obj.UserDialog)
		table.insert(texts, obj.ResponseDialog)
	end
	return texts
end

function Utils.getLineNumberFromIndex(source, index)
	local lineNumber = 1
	for i = 1, math.max(index - 1, 1) do
		if string.sub(source, i, i) == "\n" then lineNumber += 1 end
	end
	return lineNumber
end

function Utils.buildPreview(source, targetLine, radius)
	local lines = string.split(source, "\n")
	local startLine = math.max(targetLine - radius, 1)
	local endLine = math.min(targetLine + radius, #lines)
	local previewLines = {}
	for lineNumber = startLine, endLine do
		local prefix = lineNumber == targetLine and ">> " or "   "
		table.insert(previewLines, string.format("%s%d | %s", prefix, lineNumber, lines[lineNumber] or ""))
	end
	return table.concat(previewLines, "\n")
end

function Utils.scanPlainDetailed(source, query, caseSensitive)
	local matches = {}
	local startPos = 1
	local searchSource = caseSensitive and source or string.lower(source)
	local searchQuery  = caseSensitive and query  or string.lower(query)
	while true do
		local s, e = string.find(searchSource, searchQuery, startPos, true)
		if not s then break end
		table.insert(matches, { StartIndex = s, EndIndex = e, MatchText = string.sub(source, s, e) })
		startPos = e + 1
	end
	return matches
end

function Utils.scanPatternDetailed(source, luaPattern)
	local matches = {}
	local startPos = 1
	local MAX_MATCHES = 5000
	while true do
		local ok, s, e = pcall(string.find, source, luaPattern, startPos)
		if not ok then return matches, false end
		if not s then break end
		table.insert(matches, { StartIndex = s, EndIndex = e, MatchText = string.sub(source, s, e) })
		if #matches >= MAX_MATCHES then break end
		startPos = math.max(e + 1, s + 1)
	end
	return matches, true
end

function Utils.hashString(input)
	input = tostring(input or "")
	local h = 5381
	for i = 1, #input do
		h = (h * 33 + string.byte(input, i)) % 4294967296
	end
	return string.format("%08x", h)
end

return Utils
]]></ProtectedString>
