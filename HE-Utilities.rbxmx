					<ProtectedString name="Source"><![CDATA[--!strict
-- UIKit: small reusable UI-building functions. Pure functions, no state.
local Theme = require(script.Parent.Theme)
local Color = Theme.Color

local UIKit = {}

function UIKit.corner(inst, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 6)
	c.Parent = inst
	return c
end

function UIKit.stroke(inst, col, thickness)
	local s = Instance.new("UIStroke")
	s.Color = col or Color.BORDER
	s.Thickness = thickness or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = inst
	return s
end

function UIKit.padding(inst, px)
	local p = Instance.new("UIPadding")
	p.PaddingTop    = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	p.PaddingLeft   = UDim.new(0, px)
	p.PaddingRight  = UDim.new(0, px)
	p.Parent = inst
	return p
end

function UIKit.listLayout(parent, direction, pad)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad or 6)
	l.Parent = parent
	return l
end

function UIKit.label(text, size, col, font, parent)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = col or Color.TEXT
	l.Font = font or Enum.Font.GothamBold
	l.TextSize = size or 13
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.TextWrapped = true
	l.Parent = parent
	return l
end

function UIKit.button(name, text, col, parent)
	local b = Instance.new("TextButton")
	b.Name = name
	b.BackgroundColor3 = col or Color.SURFACE
	b.TextColor3 = Color.TEXT
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.Text = text
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Parent = parent
	UIKit.corner(b, 6)
	UIKit.stroke(b, Color.BORDER, 1)
	local base = col or Color.SURFACE
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = Color3.new(
			math.min(base.R + 0.1, 1), math.min(base.G + 0.1, 1), math.min(base.B + 0.1, 1))
	end)
	b.MouseLeave:Connect(function() b.BackgroundColor3 = base end)
	return b
end

function UIKit.scroll(parent, bg)
	local s = Instance.new("ScrollingFrame")
	s.BackgroundColor3 = bg or Color.SURFACE
	s.BorderSizePixel = 0
	s.ScrollBarThickness = 5
	s.ScrollBarImageColor3 = Color.BORDER
	s.CanvasSize = UDim2.new(0, 0, 0, 0)
	s.AutomaticCanvasSize = Enum.AutomaticSize.Y
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	s.ElasticBehavior = Enum.ElasticBehavior.Never
	s.Parent = parent
	return s
end

function UIKit.codeBox(scroll, editable)
	local b = Instance.new("TextBox")
	b.Size = UDim2.new(1, -8, 1, 0)
	b.AutomaticSize = Enum.AutomaticSize.Y
	b.BackgroundTransparency = 1
	b.TextColor3 = Color.TEXT
	b.PlaceholderColor3 = Color.DIM
	b.ClearTextOnFocus = false
	b.MultiLine = true
	b.TextWrapped = false
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextYAlignment = Enum.TextYAlignment.Top
	b.Font = Enum.Font.Code
	b.TextSize = 13
	b.TextEditable = editable ~= false
	b.Text = ""
	b.Parent = scroll
	UIKit.padding(b, 6)
	return b
end

function UIKit.textField(parent, placeholder)
	local t = Instance.new("TextBox")
	t.BackgroundColor3 = Color.SURFACE
	t.TextColor3 = Color.TEXT
	t.PlaceholderText = placeholder or ""
	t.PlaceholderColor3 = Color.DIM
	t.ClearTextOnFocus = false
	t.Font = Enum.Font.Code
	t.TextSize = 12
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.TextEditable = true
	t.Text = ""
	t.Parent = parent
	UIKit.corner(t, 6)
	UIKit.stroke(t, Color.BORDER)
	UIKit.padding(t, 6)
	return t
end

-- A small colored dot + bold label, used as a section header.
function UIKit.sectionLabel(text, parent, order)
	local f = Instance.new("Frame")
	f.LayoutOrder = order
	f.Size = UDim2.new(1, 0, 0, 18)
	f.BackgroundTransparency = 1
	f.Parent = parent
	UIKit.listLayout(f, Enum.FillDirection.Horizontal, 5).VerticalAlignment = Enum.VerticalAlignment.Center
	local dot = Instance.new("Frame")
	dot.LayoutOrder = 1
	dot.Size = UDim2.new(0, 6, 0, 6)
	dot.BackgroundColor3 = Color.MUTED
	dot.BorderSizePixel = 0
	dot.Parent = f
	UIKit.corner(dot, 3)
	local lbl = UIKit.label(text, 11, Color.MUTED, Enum.Font.GothamBold, f)
	lbl.LayoutOrder = 2
	lbl.Size = UDim2.new(1, -14, 1, 0)
	return f
end

-- A horizontal row container, useful for placing 2-3 buttons side by side.
function UIKit.row(parent, order, height)
	local f = Instance.new("Frame")
	f.LayoutOrder = order
	f.Size = UDim2.new(1, 0, 0, height or 28)
	f.BackgroundTransparency = 1
	f.Parent = parent
	UIKit.listLayout(f, Enum.FillDirection.Horizontal, 4)
	return f
end

return UIKit
]]></ProtectedString>
