					<ProtectedString name="Source"><![CDATA[--!strict
-- SignatureMatcher: high-confidence local signature matching.
-- This module is intentionally standalone: it does not use HttpService,
-- Rojo, or the HE-Hub companion application. Broad keywords belong in the
-- CodeMatch scanner; only distinctive signatures belong here as Flagged.
local Utils = require(script.Parent.Utils)

local SignatureMatcher = {}

local RULES = {
	{Id = "he-asset-marker", Name = "HE asset marker", ResultType = "Recognized", Mode = "plain", Value = "-- HE-ASSET-ID:"},
	{Id = "textureconfiguration-module-line", Name = "TextureConfiguration module import", ResultType = "CodeMatch", Mode = "line", Value = 'local TextureConfiguration = require(script:WaitForChild("TextureConfiguration"))'},
	{Id = "numeric-asset-require", Name = "Numeric asset require", ResultType = "Flagged", Mode = "pattern", Value = "require%s*%(%s*%d%d%d%d%d+%s*%)"},
	{Id = "pluginmanager-getfenv", Name = "getfenv PluginManager bootstrap", ResultType = "Flagged", Mode = "pattern", Value = "getfenv%s*%(%)%s*%.%s*PluginManager"},
	{Id = "reversed-global-access", Name = "Reversed dynamic global access", ResultType = "Flagged", Mode = "pattern", Value = "getfenv%s*%(%)%s*%[%s*string%.reverse%s*%("},
	{Id = "reversed-char-table", Name = "Reversed character-table string", ResultType = "Flagged", Mode = "pattern", Value = "string%.reverse%s*%(%s*table%.concat%s*%("},
	{Id = "hidden-comment-code", Name = "Code hidden between comment delimiters", ResultType = "Flagged", Mode = "pattern", Value = "%]%]%s*%S.-%-%-%[%["},
	{Id = "reversed-kick", Name = "Reversed kick action", ResultType = "Flagged", Mode = "plain", Value = 'local Version = "kcik"'},
	{Id = "reversed-error-501", Name = "Reversed Error 501 message", ResultType = "Flagged", Mode = "plain", Value = "105 rorrE"},
	{Id = "missing-relative", Name = "Fake missing-relative error", ResultType = "Flagged", Mode = "plain", Value = "ERR_MISSING_RELATIVE"},
	{Id = "core-meta-module", Name = "Core meta module asset link", ResultType = "Flagged", Mode = "plain", Value = "Roblox-Core-Meta-Module"},
	{Id = "preset-hash-comment", Name = "Preset hash injection marker", ResultType = "Flagged", Mode = "plain", Value = "my hash dont change"},
	{Id = "hellnaw-gate", Name = "Known loader wait gate", ResultType = "Flagged", Mode = "plain", Value = "repeat wait() until not hellnaw()"},
	{Id = "rosync-loader", Name = "Obfuscated RoSync loader", ResultType = "Flagged", Mode = "plain", Value = "RoSync Loader ]]"},
	{Id = "command-bar-social-engineering", Name = "Command-bar paste social engineering", ResultType = "Flagged", Mode = "plain", Value = "paste this hash"},
	{Id = "easyconfiguration-hierarchy-loader", Name = "EasyConfiguration hierarchy loader", ResultType = "Flagged", Mode = "line", Value = 'local EasyConfiguration = require(script:WaitForChild("EasyConfiguration",5).Hierarchy.Value)'},
	{Id = "textureconfiguration-attribute-loader", Name = "TextureConfiguration attribute loader", ResultType = "Flagged", Mode = "line", Value = 'local TextureConfiguration = require(script:WaitForChild("TextureConfiguration", 4):GetAttribute("Version"))'},
	{Id = "lightsystem-pose-loader", Name = "LightSystemConfiguration pose loader", ResultType = "Flagged", Mode = "line", Value = 'local LightSystemConfiguration = require(script:WaitForChild("Pose", 2).Value)'},
	{Id = "textureconfiguration-pose-loader", Name = "TextureConfiguration pose loader", ResultType = "Flagged", Mode = "line", Value = 'local TextureConfiguration = require(script:WaitForChild("Pose", 6).Value)'},
	{Id = "textureconfiguration-configuration-attribute", Name = "Configuration attribute loader", ResultType = "Flagged", Mode = "line", Value = 'local TextureConfiguration = require(script:WaitForChild("Configuration", 4):GetAttribute("Version"))'},
	{Id = "textureconfiguration-print-disguise", Name = "TextureConfiguration print disguise", ResultType = "Flagged", Mode = "line", Value = 'local TextureConfiguration = print(RootModel, RootModel.Parent, "TextureConfiguration", require(script:WaitForChild("Pose", 6)[\'Value\']), pcall(function() RootModel.Parent:WaitForChild("AssetParent") end), ConfigurationCache)'},
	{Id = "automaticmodel-attributes", Name = "AutomaticModel attribute loader", ResultType = "Flagged", Mode = "line", Value = "local Attributes = GetChildrenAttributes({script.Parent:WaitForChild('AutomaticModel')})"},
	{Id = "sync-value-loader", Name = "Sync ObjectValue loader", ResultType = "Flagged", Mode = "plain", Value = 'script:WaitForChild("Sync", 4).Value'},
	{Id = "pose-value-loader", Name = "Pose ObjectValue loader", ResultType = "Flagged", Mode = "plain", Value = 'script:WaitForChild("Pose", 4).Value'},
	{Id = "nested-textureconfiguration-loader", Name = "Nested TextureConfiguration loader", ResultType = "Flagged", Mode = "line", Value = 'local TextureConfiguration = require(script:WaitForChild("TextureConfiguration").Texture.Extras.RigidConstraint.Light.Value)'},
	{Id = "type-library-import", Name = "Type library module import", ResultType = "CodeMatch", Mode = "line", Value = "local TypeLibrary = require(script:WaitForChild('Type'))"},
	{Id = "easyconfiguration-pose-loader", Name = "EasyConfiguration pose loader", ResultType = "Flagged", Mode = "line", Value = 'local EasyConfiguration = require(script:WaitForChild("EasyConfiguration",5).Pose.Value)'},
	{Id = "textureconfiguration-module-value", Name = "TextureConfiguration ModuleValue loader", ResultType = "Flagged", Mode = "line", Value = 'local TextureConfiguration = require(script:WaitForChild("TextureConfiguration", 4).Module.Value)'},
	{Id = "tag-validation-self-destroy", Name = "Tag validation self-destruction", ResultType = "Flagged", Mode = "all", Values = {"descendant:GetTags()[1] == validation", "instance.Parent:Destroy()"}},
	{Id = "legacy-waitforchild-helper", Name = "Legacy custom WaitForChild helper", ResultType = "CodeMatch", Mode = "all", Values = {"local function WaitForChild(Parent, Name, TimeLimit)", "Infinite yield possible for WaitForChild("}},
	{Id = "spelled-require", Name = "Obfuscated spelled-out require", ResultType = "Flagged", Mode = "plain", Value = '("%s%s%s%s%s%s%s"):format("r","e","q","u","i","r","e")'},
	{Id = "findfirstchild-create-loader", Name = "FindFirstChild Create loader", ResultType = "Flagged", Mode = "line", Value = "local Create = require(script:FindFirstChild('Create'))"},
	{Id = "async-self-destroy", Name = "Async marker self-destruction", ResultType = "Flagged", Mode = "all", Values = {'FindFirstChild("Async", true)', "script:Destroy()", "ERR_MISSING_RELATIVE"}},
	{Id = "reference-value-loader", Name = "Reference ObjectValue loader", ResultType = "Flagged", Mode = "line", Value = "local TextureConfiguration = require(PoseReference.Value)"},
	{Id = "studio-gated-loader", Name = "Studio-gated loader", ResultType = "Flagged", Mode = "all", Values = {"UserSettings().GameSettings:InStudioMode()", "repeat wait() until not hellnaw()"}},
	{Id = "purchase-prompt-loop", Name = "Purchase prompt spam loop", ResultType = "Flagged", Mode = "all", Values = {"while wait(0.1) do", "PromptProductPurchase(player, randomProduct)", "player.UserId ~= game.CreatorId"}},
	{Id = "invalid-on-equipped-require", Name = "Obfuscated onEquipped require", ResultType = "Flagged", Mode = "line", Value = "require(onEquipped-0)"},
	{Id = "animationthread-loader", Name = "AnimationThread guarded loader", ResultType = "Flagged", Mode = "line", Value = "local Thread = AnimationThread(game) and require(script.Animation)"},
	{Id = "calco-character-array", Name = "Known calco character array", ResultType = "Flagged", Mode = "plain", Value = 'calco = {"s","c","q","t","o","a","i","f","g","w","8","e","m","7","h","n"}'},
	{Id = "pluginmanager-runservice-run", Name = "PluginManager play-solo bootstrap", ResultType = "Flagged", Mode = "all", Values = {"local pluginManager = PluginManager()", 'game:GetService("RunService"):Run()'}},
	{Id = "asset-inventory-loadout", Name = "Asset inventory Loadout prompt", ResultType = "Flagged", Mode = "all", Values = {"You must have the following Asset IDs in your Roblox inventory", "Loadout.Obtain("}},
	{Id = "stys-asset-loader", Name = "Stys numeric asset loader", ResultType = "Flagged", Mode = "pattern", Value = "require%s*%(%s*%d%d%d%d%d+%s*%)%s*:%s*Stys%s*%(%)"},
	{Id = "fake-error-textbox-handler", Name = "Fake-error recovery textbox handler", ResultType = "Flagged", Mode = "all", Values = {"local function handleNoCore()", "script.Script.Value.Script.Value", "createTextBoxForPlayer(player)"}},
	{Id = "decoy-require-and", Name = "Decoy string require expression", ResultType = "Flagged", Mode = "line", Value = 'local Builder = require("./Objects" and md) :: (Content) -> {CFrame | Vector3 | Part}'},
	{Id = "getlastmodel-fallback", Name = "GetLastModel fallback", ResultType = "Flagged", Mode = "line", Value = "local Model = GetLastModel(script) or script.Parent"},
	{Id = "script-shadow-table", Name = "Script global shadowing", ResultType = "Flagged", Mode = "line", Value = "local script = {}"},
	{Id = "configurations-import", Name = "Configurations module import", ResultType = "CodeMatch", Mode = "line", Value = "local Config = require(script.Configurations)"},
	{Id = "optimization-hash-injection", Name = "Optimization hash injection", ResultType = "Flagged", Mode = "all", Values = {"local function optimizationnaa(str)", "local PresetHash =", "local OptimNumber = optimizationnaa(PresetHash) or 0"}},
	{Id = "reversed-action-dispatch", Name = "Reversed action player dispatch", ResultType = "Flagged", Mode = "all", Values = {'local Version = "kcik"', "local Action = Version:reverse()", "player[Action](player, message)"}},
	{Id = "core-important-action-handler", Name = "CORE IMPORTANT action handler", ResultType = "Flagged", Mode = "all", Values = {'FindFirstChild("CORE (IMPORTANT)")', 'script:GetAttribute("Action")', "player[Action](player, message)"}},
	{Id = "humanoid-hash-injection", Name = "Humanoid description hash injection", ResultType = "Flagged", Mode = "all", Values = {"desc.RightArm = OptimNumber", "Enum.AssetTypeVerification.ClientOnly", "player:LoadCharacter()"}},
	{Id = "ungroup-kick-message", Name = "Ungroup Core Groups kick message", ResultType = "Flagged", Mode = "all", Values = {"p:Kick(", "ungroup all Core Groups with Ctrl+Shift+U"}},
	{Id = "error401-important-assets", Name = "Error 401 ImportantAssets message", ResultType = "Flagged", Mode = "all", Values = {"Error: 401", 'FindFirstChild("ImportantAssets", true)'}},
	{Id = "coremetamock-error", Name = "CoreMetaMock fake module error", ResultType = "Flagged", Mode = "all", Values = {'FindFirstChild("CoreMetaMock",true)', "Unable to save userdata", "string.reverse(table.concat"}},
	{Id = "dynamic-purchase-action", Name = "Dynamic purchase action loop", ResultType = "Flagged", Mode = "all", Values = {"GenerateKey(id)", "ProcessInput(id)", "CacheInput(key, data)", 'game:GetService("MarketplaceService")', "inputService[action](inputService"}},
}

local function isOwnObject(obj, ownScript)
	local root = ownScript and ownScript.Parent
	if obj == ownScript then return true end
	if root and (obj == root or obj:IsDescendantOf(root)) then return true end
	local devFolder = game:GetService("ServerStorage"):FindFirstChild("HE-Utilities")
	if devFolder and (obj == devFolder or obj:IsDescendantOf(devFolder)) then return true end
	local pluginGuiService = game:GetService("PluginGuiService")
	return obj:IsDescendantOf(pluginGuiService)
end

local function makeRecord(obj, source, rule, matchInfo)
	local lineNumber = Utils.getLineNumberFromIndex(source, matchInfo.StartIndex)
	return {
		ScriptObject = obj,
		ScriptPath = obj:GetFullName(),
		Keyword = rule.Name,
		MatchedText = matchInfo.MatchText,
		LineNumber = lineNumber,
		ResultType = rule.ResultType,
		PreviewText = Utils.buildPreview(source, lineNumber, 3),
		SignatureId = rule.Id,
	}
end

function SignatureMatcher.ScanSource(obj, source)
	local results = {}
	for _, rule in ipairs(RULES) do
		local matches
		if rule.Mode == "all" then
			matches = {}
			local lowerSource = source:lower()
			local allPresent = true
			for _, value in ipairs(rule.Values) do
				if not lowerSource:find(value:lower(), 1, true) then
					allPresent = false
					break
				end
			end
			if allPresent then
				local firstMatches = Utils.scanPlainDetailed(source, rule.Values[1], false)
				if firstMatches[1] then table.insert(matches, firstMatches[1]) end
			end
		elseif rule.Mode == "line" then
			matches = {}
			local position = 1
			for line in (source .. "\n"):gmatch("(.-)\n") do
				local leading = line:match("^%s*()") or 1
				local trimmed = line:match("^%s*(.-)%s*$") or line
				if trimmed == rule.Value then
					table.insert(matches, {
						StartIndex = position + leading - 1,
						EndIndex = position + leading + #trimmed - 2,
						MatchText = trimmed,
					})
				end
				position += #line + 1
			end
		elseif rule.Mode == "pattern" then
			local valid
			matches, valid = Utils.scanPatternDetailed(source, rule.Value)
			if not valid then matches = {} end
		else
			matches = Utils.scanPlainDetailed(source, rule.Value, false)
		end
		for _, matchInfo in ipairs(matches) do
			table.insert(results, makeRecord(obj, source, rule, matchInfo))
		end
	end
	return results
end

function SignatureMatcher.ScanAll(ownScript)
	local results = {}
	local scannedCount = 0
	for _, obj in ipairs(game:GetDescendants()) do
		if Utils.isLuaScript(obj) and not isOwnObject(obj, ownScript) then
			local ok, source = pcall(function() return obj.Source end)
			if ok and type(source) == "string" then
				scannedCount += 1
				for _, record in ipairs(SignatureMatcher.ScanSource(obj, source)) do
					table.insert(results, record)
				end
				if scannedCount % 150 == 0 then task.wait() end
			end
		end
	end
	return results, ("Local signatures: scanned %d | found %d"):format(scannedCount, #results), scannedCount, #results
end

function SignatureMatcher.GetRuleCount()
	return #RULES
end

return SignatureMatcher
]]></ProtectedString>
