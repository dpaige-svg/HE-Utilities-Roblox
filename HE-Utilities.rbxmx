					<ProtectedString name="Source"><![CDATA[--!strict
-- ScanEngine: runs each scan type over game:GetDescendants() and returns
-- a flat array of result records. Stateless per-call except for the
-- "own object" exclusion, which needs to know this script + the keyword
-- module's names.
local Utils = require(script.Parent.Utils)

local ScanEngine = {}
ScanEngine.__index = ScanEngine

local MAX_SCAN_ENTRIES = 500
local MAX_SCAN_ENTRY_LENGTH = 300
local YIELD_EVERY = 150

local REFERENCE_PROPERTY_CLASSES = {
	WeldConstraint = {"Part0", "Part1"}, Weld = {"Part0", "Part1"},
	Motor6D = {"Part0", "Part1"}, Motor = {"Part0", "Part1"},
	ManualWeld = {"Part0", "Part1"}, ManualGlue = {"Part0", "Part1"},
	RopeConstraint = {"Attachment0", "Attachment1"},
	RodConstraint = {"Attachment0", "Attachment1"},
	SpringConstraint = {"Attachment0", "Attachment1"},
	BallSocketConstraint = {"Attachment0", "Attachment1"},
	HingeConstraint = {"Attachment0", "Attachment1"},
	PrismaticConstraint = {"Attachment0", "Attachment1"},
	CylindricalConstraint = {"Attachment0", "Attachment1"},
	LineForce = {"Attachment0", "Attachment1"},
	AlignPosition = {"Attachment0"}, AlignOrientation = {"Attachment0"},
	VectorForce = {"Attachment0"}, Torque = {"Attachment0"},
}

local function wordBounded(pattern)
	return "%f[%a]" .. pattern .. "%f[%A]"
end

local PROFANITY_PATTERNS = {}
do
	local rawPatterns = {
		"f+u+c+k+", "f+[^%a]*u+[^%a]*c+[^%a]*k+", "[f]+[u4@]+[c%(]+[k]+",
		"sh[i!1]+t+", "b[i!1]+t+c+h+", "a+s+s+h+o+l+e+", "a+[s$]+[s$]+",
		"d+[i!1]+c+k+", "c+[o0]+c+k+", "p+[u]+s+[s$]+[y]+", "c+u+n+t+",
		"n+[i!1]+g+[g]+[e3]+[r]+", "n+[i!1]+g+[g]+[a@]+",
		"f+[a@4]+g+[g]*[o0]*[t]*", "r+[e3]+t+[a@4]+r+d+",
		"wh+[o0]+r+[e3]+", "[s$]+l+[u]+t+", "b+[a@4]+[s$]+t+[a@4]+r+d+",
		"[ck]+r+[a@4]+p+", "p+[e3]+[e3]+[n]+[i!1]+[s$]+", "[a@4]+n+[u]+[s$]+",
	}
	for _, raw in ipairs(rawPatterns) do table.insert(PROFANITY_PATTERNS, wordBounded(raw)) end
end

function ScanEngine.new(ownScript)
	local self = setmetatable({}, ScanEngine)
	self.OwnScript = ownScript
	self.CaseSensitivePlainSearch = false
	self.YieldCallback = nil -- optional function(count) called periodically to keep Studio responsive
	return self
end

function ScanEngine:_maybeYield(counter)
	if counter % YIELD_EVERY == 0 then task.wait() end
	if self.YieldCallback then self.YieldCallback(counter) end
end

function ScanEngine:_isOwnObject(obj)
	local root = self.OwnScript.Parent -- the HE-Utilities folder (Init's parent)
	if obj == self.OwnScript then return true end
	if root and (obj == root or obj:IsDescendantOf(root)) then return true end

	-- A dev/source copy of the plugin can coexist in ServerStorage
	-- (separate Instance from the actual installed plugin) — exclude it
	-- too so it doesn't self-flag its own keyword list as matches.
	local devFolder = game:GetService("ServerStorage"):FindFirstChild("HE-Utilities")
	if devFolder and (obj == devFolder or obj:IsDescendantOf(devFolder)) then return true end

	-- Plugin UI (ours or any other plugin's) isn't real place content.
	local pluginGuiService = game:GetService("PluginGuiService")
	if obj:IsDescendantOf(pluginGuiService) then return true end

	return false
end

local function makeRecord(obj, keyword, matchedText, lineNumber, resultType, previewText)
	return {
		ScriptObject = obj,
		ScriptPath = obj:GetFullName(),
		Keyword = keyword,
		MatchedText = matchedText,
		LineNumber = lineNumber,
		ResultType = resultType,
		PreviewText = previewText,
	}
end

-- ScanAll: keyword/pattern search across scripts and UI text.
function ScanEngine:ScanAll(keywordEntries)
	if #keywordEntries == 0 then return {}, "Add at least one keyword or pattern.", 0, 0 end
	if #keywordEntries > MAX_SCAN_ENTRIES then
		return {}, ("Too many keywords (%d, max %d)."):format(#keywordEntries, MAX_SCAN_ENTRIES), 0, 0
	end
	for _, entry in ipairs(keywordEntries) do
		if #entry > MAX_SCAN_ENTRY_LENGTH then
			return {}, "A keyword exceeds " .. MAX_SCAN_ENTRY_LENGTH .. " characters.", 0, 0
		end
	end
	local results = {}
	local scannedCount, unreadableCount = 0, 0
	for _, obj in ipairs(game:GetDescendants()) do
		if Utils.isLuaScript(obj) and not self:_isOwnObject(obj) then
			local ok, source = pcall(function() return obj.Source end)
			scannedCount += 1
			self:_maybeYield(scannedCount)
			if ok and type(source) == "string" then
				for entryIndex, entry in ipairs(keywordEntries) do
					if entryIndex % 25 == 0 then task.wait() end
					local patternMatches, patternValid = Utils.scanPatternDetailed(source, entry)
					local matchesToUse = (not patternValid)
						and Utils.scanPlainDetailed(source, entry, self.CaseSensitivePlainSearch)
						or patternMatches
					for _, matchInfo in ipairs(matchesToUse) do
						local lineNumber = Utils.getLineNumberFromIndex(source, matchInfo.StartIndex)
						table.insert(results, makeRecord(obj, entry, matchInfo.MatchText, lineNumber,
							"CodeMatch", Utils.buildPreview(source, lineNumber, 3)))
					end
				end
			else
				unreadableCount += 1
			end
		elseif Utils.isTextUIObject(obj) and not self:_isOwnObject(obj) then
			scannedCount += 1
			self:_maybeYield(scannedCount)
			for _, text in ipairs(Utils.getScannableTexts(obj)) do
				if type(text) == "string" and text ~= "" then
					for _, entry in ipairs(keywordEntries) do
						local patternMatches, patternValid = Utils.scanPatternDetailed(text, entry)
						local matchesToUse = patternValid and patternMatches or Utils.scanPlainDetailed(text, entry, self.CaseSensitivePlainSearch)
						for _, matchInfo in ipairs(matchesToUse) do
							table.insert(results, makeRecord(obj, entry, matchInfo.MatchText, 1, "UIText",
								"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nText: " .. text))
						end
					end
				end
			end
		end
	end
	return results, ("Done. Scanned: %d | Found: %d | Unreadable: %d"):format(scannedCount, #results, unreadableCount), scannedCount, #results
end

function ScanEngine:ScanAttributes()
	local results, scannedCount = {}, 0
	for _, obj in ipairs(game:GetDescendants()) do
		if Utils.isAttributeScannable(obj) and not self:_isOwnObject(obj) then
			scannedCount += 1
			self:_maybeYield(scannedCount)
			local attributes = obj:GetAttributes()
			if next(attributes) ~= nil then
				local attributePairs = {}
				for attrName, attrValue in pairs(attributes) do
					table.insert(attributePairs, tostring(attrName) .. " = " .. tostring(attrValue))
				end
				table.sort(attributePairs)
				table.insert(results, makeRecord(obj, "Attribute", obj.ClassName .. " | " .. table.concat(attributePairs, ", "),
					1, "Attributes", "[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\n" .. table.concat(attributePairs, "\n")))
			end
		end
	end
	return results, ("Attribute scan done. Scanned: %d | Objects with attributes: %d"):format(scannedCount, #results), scannedCount, #results
end

function ScanEngine:ScanProfanity()
	local results, scannedCount = {}, 0
	for _, obj in ipairs(game:GetDescendants()) do
		scannedCount += 1
		self:_maybeYield(scannedCount)
		if Utils.isLuaScript(obj) and not self:_isOwnObject(obj) then
			local ok, source = pcall(function() return obj.Source end)
			if ok and type(source) == "string" then
				local lowerSource = string.lower(source)
				for _, pattern in ipairs(PROFANITY_PATTERNS) do
					local matches, valid = Utils.scanPatternDetailed(lowerSource, pattern)
					if valid then
						for _, matchInfo in ipairs(matches) do
							local lineNum = Utils.getLineNumberFromIndex(source, matchInfo.StartIndex)
							table.insert(results, makeRecord(obj, pattern, source:sub(matchInfo.StartIndex, matchInfo.EndIndex),
								lineNum, "Profanity", Utils.buildPreview(source, lineNum, 3)))
						end
					end
				end
			end
		elseif Utils.isTextUIObject(obj) and not self:_isOwnObject(obj) then
			for _, text in ipairs(Utils.getScannableTexts(obj)) do
				if type(text) == "string" and text ~= "" then
					local lowerText = string.lower(text)
					for _, pattern in ipairs(PROFANITY_PATTERNS) do
						local matches, valid = Utils.scanPatternDetailed(lowerText, pattern)
						if valid and #matches > 0 then
							table.insert(results, makeRecord(obj, "UIText", text, 1, "Profanity",
								"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nText: " .. text))
						end
					end
				end
			end
		end
		if Utils.isAttributeScannable(obj) and not self:_isOwnObject(obj) then
			for attrName, attrValue in pairs(obj:GetAttributes()) do
				if type(attrValue) == "string" then
					local lowerVal = string.lower(attrValue)
					for _, pattern in ipairs(PROFANITY_PATTERNS) do
						local matches, valid = Utils.scanPatternDetailed(lowerVal, pattern)
						if valid and #matches > 0 then
							table.insert(results, makeRecord(obj, "Attr:" .. attrName, attrName .. " = " .. attrValue, 1, "Profanity",
								"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nAttribute: " .. attrName .. " = " .. attrValue))
						end
					end
				end
			end
		end
	end
	return results, ("Profanity scan done | Scanned: %d | Found: %d"):format(scannedCount, #results), scannedCount, #results
end

function ScanEngine:ScanUserIds(specificIdText)
	local results, scannedCount = {}, 0
	local specificId = specificIdText and specificIdText:match("^%s*(%d+)%s*$") or nil
	local userIdPatterns = {
		"%.UserId%s*[=~]=?%s*%d+", "GetUserIdFromNameAsync", "GetNameFromUserIdAsync",
		"[Aa]dmin[Ii][Dd]s?", "[Ww]hite[Ll]ist", "[Bb]lack[Ll]ist",
		"[Aa]llowed[Uu]sers?", "[Bb]anned[Uu]sers?", "[Oo]wner[Ii][Dd]",
	}
	if specificId then table.insert(userIdPatterns, 1, "%f[%d]" .. specificId .. "%f[%D]") end
	for _, obj in ipairs(game:GetDescendants()) do
		scannedCount += 1
		self:_maybeYield(scannedCount)
		if Utils.isLuaScript(obj) and not self:_isOwnObject(obj) then
			local ok, source = pcall(function() return obj.Source end)
			if ok and type(source) == "string" then
				for _, pattern in ipairs(userIdPatterns) do
					local matches, valid = Utils.scanPatternDetailed(source, pattern)
					if valid then
						for _, matchInfo in ipairs(matches) do
							local lineNum = Utils.getLineNumberFromIndex(source, matchInfo.StartIndex)
							table.insert(results, makeRecord(obj, pattern, matchInfo.MatchText, lineNum, "UserId",
								Utils.buildPreview(source, lineNum, 3)))
						end
					end
				end
			end
		end
		if Utils.isAttributeScannable(obj) and not self:_isOwnObject(obj) then
			for attrName, attrValue in pairs(obj:GetAttributes()) do
				local numVal = tonumber(tostring(attrValue))
				if numVal then
					local isMatch = specificId and (numVal == tonumber(specificId))
						or (not specificId and numVal >= 100000 and numVal <= 9999999999)
					if isMatch then
						table.insert(results, makeRecord(obj, "AttributeUserId", attrName .. " = " .. tostring(attrValue), 1, "UserId",
							"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nAttribute: " .. attrName .. " = " .. tostring(attrValue)))
					end
				end
			end
		end
	end
	local filterText = specificId and ("for ID " .. specificId) or "(all patterns)"
	return results, ("UserID scan done %s | Scanned: %d | Found: %d"):format(filterText, scannedCount, #results), scannedCount, #results
end

function ScanEngine:ScanTags(filterTagText)
	local CollectionService = game:GetService("CollectionService")
	local results, scannedCount = {}, 0
	local filterTag = filterTagText and filterTagText:match("^%s*(.-)%s*$") or ""
	if filterTag == "" then filterTag = nil end
	if filterTag then
		local tagged = CollectionService:GetTagged(filterTag)
		scannedCount = #tagged
		for i, obj in ipairs(tagged) do
			self:_maybeYield(i)
			local tags = CollectionService:GetTags(obj)
			table.insert(results, makeRecord(obj, filterTag, "[" .. obj.ClassName .. "] " .. table.concat(tags, ", "), 1, "Tag",
				"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nTags: " .. table.concat(tags, ", ")))
		end
	else
		for _, obj in ipairs(game:GetDescendants()) do
			scannedCount += 1
			self:_maybeYield(scannedCount)
			local tags = CollectionService:GetTags(obj)
			if #tags > 0 then
				table.insert(results, makeRecord(obj, "Tag", "[" .. obj.ClassName .. "] " .. table.concat(tags, ", "), 1, "Tag",
					"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nTags: " .. table.concat(tags, ", ")))
			end
		end
	end
	local filterText = filterTag and ('"' .. filterTag .. '"') or "(all tags)"
	return results, ("Tag scan done %s | Scanned: %d | Found: %d"):format(filterText, scannedCount, #results), scannedCount, #results
end

local function tryResolveRequirePath(originScript, expr)
	expr = expr:match("^%s*(.-)%s*$")
	if expr == "" then return nil, false end
	if expr:match("^%-?%d+$") then return nil, false end
	if expr:match("[%+%-%*/%%]") then return nil, false end
	if expr:match('^"') or expr:match("^'") then return nil, false end
	local current, rest
	local serviceName = expr:match('^game%s*:%s*GetService%(%s*"([%w_]+)"%s*%)')
	if serviceName then
		local ok, svc = pcall(game.GetService, game, serviceName)
		if not ok then return nil, false end
		current = svc
		rest = expr:match('^game%s*:%s*GetService%(%s*"[%w_]+"%s*%)%.?(.*)$') or ""
	elseif expr:match("^script") then
		current = originScript
		rest = expr:match("^script%.?(.*)$") or ""
	elseif expr == "game" or expr:match("^game%.") then
		current = game
		rest = expr:match("^game%.?(.*)$") or ""
	elseif expr == "workspace" or expr:match("^workspace%.") then
		current = workspace
		rest = expr:match("^workspace%.?(.*)$") or ""
	else
		return nil, false
	end
	if rest == "" then return current, true end
	for segment in rest:gmatch("[^%.]+") do
		segment = segment:match("^%s*(.-)%s*$")
		if current == nil then return nil, true end
		local waitName = segment:match('^WaitForChild%(%s*"([^"]+)"%s*%)$')
		local findName = segment:match('^FindFirstChild%(%s*"([^"]+)"%s*%)$')
		if segment == "Parent" then
			current = current.Parent
		elseif waitName then
			current = current:FindFirstChild(waitName)
		elseif findName then
			current = current:FindFirstChild(findName)
		elseif segment:match("^[%a_][%w_]*$") then
			local ok, child = pcall(current.FindFirstChild, current, segment)
			if not ok then return nil, false end
			current = child
		else
			return nil, false
		end
	end
	return current, true
end

function ScanEngine:ScanMissingReferences()
	local results, scannedCount = {}, 0
	for _, obj in ipairs(game:GetDescendants()) do
		scannedCount += 1
		self:_maybeYield(scannedCount)
		if self:_isOwnObject(obj) then continue end
		if obj:IsA("ObjectValue") and obj.Value == nil then
			table.insert(results, makeRecord(obj, "ObjectValue.Value", "ObjectValue '" .. obj.Name .. "' has no Value set",
				1, "MissingRef", "[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\nValue: nil"))
		end
		local refProps = REFERENCE_PROPERTY_CLASSES[obj.ClassName]
		if refProps then
			for _, propName in ipairs(refProps) do
				local ok, value = pcall(function() return obj[propName] end)
				if ok and value == nil then
					table.insert(results, makeRecord(obj, obj.ClassName .. "." .. propName,
						obj.ClassName .. " '" .. obj.Name .. "' has no " .. propName, 1, "MissingRef",
						"[" .. obj.ClassName .. "] " .. obj:GetFullName() .. "\n" .. propName .. ": nil"))
				end
			end
		end
		if Utils.isLuaScript(obj) then
			local ok, source = pcall(function() return obj.Source end)
			if ok and type(source) == "string" then
				local searchPos = 1
				while true do
					local sIdx, eIdx, expr = source:find("require%s*%(%s*([^%)]-)%s*%)", searchPos)
					if not sIdx then break end
					searchPos = eIdx + 1
					local resolved, attempted = tryResolveRequirePath(obj, expr)
					if attempted and resolved == nil then
						local lineNum = Utils.getLineNumberFromIndex(source, sIdx)
						table.insert(results, makeRecord(obj, "require()", "require(" .. expr .. ") could not be resolved",
							lineNum, "MissingRef", Utils.buildPreview(source, lineNum, 3)))
					end
				end
			end
		end
	end
	return results, ("Missing-reference scan done. Scanned: %d | Found: %d"):format(scannedCount, #results), scannedCount, #results
end

return ScanEngine
]]></ProtectedString>
