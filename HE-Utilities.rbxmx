				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- KeywordLibrary: owns the keyword/pattern list entirely via the plugin's
-- own persistent settings (plugin:SetSetting/GetSetting). This is
-- deliberately NOT stored as a ModuleScript in the game (e.g.
-- ReplicatedStorage) — that tied the keyword list to whichever place
-- happened to be open. Storing it on the plugin means it travels with
-- the plugin itself across every place and every computer it's installed on.
--
-- Profiles: keywords are grouped into named profiles (e.g. "Default",
-- "Strict", "UI-only"). Only one profile is "active" at a time — that's
-- the one GetKeywords()/SaveKeywords()/SyncRemote() read and write, and
-- the one RunAutoScan() in MainController scans with. Older installs that
-- only ever had a flat keyword list get auto-migrated into a "Default"
-- profile the first time GetProfiles() runs.
local Utils = require(script.Parent.Utils)

local HttpService = game:GetService("HttpService")

local KEYWORDS_SETTING = "MaliciousFinder_Keywords" -- legacy, pre-profiles
local REMOTE_URL_SETTING = "MaliciousFinder_RemoteUrl"
local PROFILES_SETTING = "MaliciousFinder_Profiles"
local ACTIVE_PROFILE_SETTING = "MaliciousFinder_ActiveProfile"

local DEFAULT_PROFILE_NAME = "Default"

local DEFAULT_KEYWORDS = {
	"%.UserId%s*==%s*%d+","%.UserId%s*~=%s*%d+","Admin","admin",
	"adminIds","allowedUsers","AnimationThread","bannedUsers",
	"Bindford","blackList","Builder","Chatted",
	"CollideFix","Colorize","Configurations","Controller",
	"CoreMeta","coroutine%.wrap","damarco","debug%.getinfo",
	"debug%.info","diagOutput","discord","EasyConfiguration",
	"EffectBuilder","game%s*=","getfenv","GetNameFromUserIdAsync",
	"GetTags","GetUserIdFromNameAsync","HandleAnimationWithConditionsAndChain","handleMissingCore",
	"handleNoCore","HitboxCore","HttpService","HttpService%s*:%s*GetAsync%s*%(",
	"HttpService%s*:%s*PostAsync%s*%(","initializeMeshPipeline","InsertService","JobId",
	"jump2","Kick","Loader%.Value","loadstring",
	"MarketplaceService%s*:%s*GetProductInfo","MaxWelds","MeshQualifier","NewConstants",
	"ObjectGroup","ParticleThread","pcall","PerfectionWeld",
	"PositionsFix","PromptProductPurchase","PromptPurchase","require",
	"require%s*%(%s*%d+%s*%)","reverse","RoSync","RunEffectBuilder",
	"script%.Source","script%s*=","serverstate","setfenv",
	"ShouldBreakJoints","ShouldFixJoints","ShouldWeld","spread",
	"string%.char%s*%(","suspicious","TeleportService","TextureConfiguration",
	"UniversalSynSaveInstance","UserID","UserId","WeldSaver",
	"whiteList",
}

local MAX_REMOTE_RESPONSE_BYTES = 100000
local MAX_REMOTE_KEYWORDS = 1000
local MAX_KEYWORD_LENGTH = 200
local MAX_PROFILE_NAME_LENGTH = 60

local KeywordLibrary = {}
KeywordLibrary.__index = KeywordLibrary

function KeywordLibrary.new(plugin)
	local self = setmetatable({}, KeywordLibrary)
	self.Plugin = plugin
	return self
end

local function normalizeKeywords(lines)
	local out, seen = {}, {}
	for _, line in ipairs(lines) do
		local trimmed = line:match("^%s*(.-)%s*$")
		if trimmed and trimmed ~= "" and not seen[trimmed] then
			seen[trimmed] = true
			table.insert(out, trimmed)
		end
	end
	table.sort(out, function(a, b) return string.lower(a) < string.lower(b) end)
	return out
end

local function normalizeProfileName(name)
	if type(name) ~= "string" then return nil end
	local trimmed = name:match("^%s*(.-)%s*$")
	if trimmed == "" then return nil end
	if #trimmed > MAX_PROFILE_NAME_LENGTH then
		trimmed = trimmed:sub(1, MAX_PROFILE_NAME_LENGTH)
	end
	return trimmed
end

----------------------------------------------------------------
-- PROFILES
----------------------------------------------------------------

-- Returns the raw profiles table: { [name] = {keyword, keyword, ...} }.
-- Handles first-run seeding and migration from the old flat keyword list.
function KeywordLibrary:_loadProfilesRaw()
	local ok, stored = pcall(function() return self.Plugin:GetSetting(PROFILES_SETTING) end)
	if ok and type(stored) == "table" and next(stored) ~= nil then
		return stored
	end

	-- Migration: an older install may have a flat keyword list saved under
	-- the legacy setting. Bring it in as the "Default" profile instead of
	-- silently discarding it.
	local legacyOk, legacyKeywords = pcall(function() return self.Plugin:GetSetting(KEYWORDS_SETTING) end)
	local seedKeywords
	if legacyOk and type(legacyKeywords) == "table" and #legacyKeywords > 0 then
		seedKeywords = normalizeKeywords(legacyKeywords)
	else
		seedKeywords = normalizeKeywords(DEFAULT_KEYWORDS)
	end

	local profiles = { [DEFAULT_PROFILE_NAME] = seedKeywords }
	pcall(function() self.Plugin:SetSetting(PROFILES_SETTING, profiles) end)
	pcall(function() self.Plugin:SetSetting(ACTIVE_PROFILE_SETTING, DEFAULT_PROFILE_NAME) end)
	return profiles
end

function KeywordLibrary:_saveProfilesRaw(profiles)
	return pcall(function() self.Plugin:SetSetting(PROFILES_SETTING, profiles) end)
end

-- Returns a sorted list of profile names.
function KeywordLibrary:GetProfileNames()
	local profiles = self:_loadProfilesRaw()
	local names = {}
	for name in pairs(profiles) do table.insert(names, name) end
	table.sort(names, function(a, b) return string.lower(a) < string.lower(b) end)
	return names
end

-- Returns the active profile name, falling back to the first available
-- profile (alphabetically) if the stored active name no longer exists.
function KeywordLibrary:GetActiveProfile()
	local profiles = self:_loadProfilesRaw()
	local ok, active = pcall(function() return self.Plugin:GetSetting(ACTIVE_PROFILE_SETTING) end)
	if ok and type(active) == "string" and profiles[active] ~= nil then
		return active
	end
	local names = self:GetProfileNames()
	local fallback = names[1] or DEFAULT_PROFILE_NAME
	pcall(function() self.Plugin:SetSetting(ACTIVE_PROFILE_SETTING, fallback) end)
	return fallback
end

-- Switches the active profile. Returns (success, message).
function KeywordLibrary:SetActiveProfile(name)
	local normalized = normalizeProfileName(name)
	if not normalized then return false, "Profile name can't be empty." end
	local profiles = self:_loadProfilesRaw()
	if profiles[normalized] == nil then
		return false, ('Profile "%s" doesn\'t exist.'):format(normalized)
	end
	local ok, err = pcall(function() self.Plugin:SetSetting(ACTIVE_PROFILE_SETTING, normalized) end)
	if not ok then return false, "Couldn't switch profile: " .. tostring(err) end
	return true, ('Switched to "%s".'):format(normalized)
end

-- Creates a new empty (or seeded) profile and makes it active.
-- Returns (success, message).
function KeywordLibrary:CreateProfile(name, seedKeywords)
	local normalized = normalizeProfileName(name)
	if not normalized then return false, "Profile name can't be empty." end
	local profiles = self:_loadProfilesRaw()
	if profiles[normalized] ~= nil then
		return false, ('A profile named "%s" already exists.'):format(normalized)
	end
	profiles[normalized] = normalizeKeywords(seedKeywords or {})
	local ok, err = self:_saveProfilesRaw(profiles)
	if not ok then return false, "Couldn't create profile: " .. tostring(err) end
	self:SetActiveProfile(normalized)
	return true, ('Created profile "%s".'):format(normalized)
end

-- Deletes a profile. Refuses to delete the last remaining profile. If the
-- deleted profile was active, switches active to another one automatically.
-- Returns (success, message).
function KeywordLibrary:DeleteProfile(name)
	local normalized = normalizeProfileName(name)
	if not normalized then return false, "Profile name can't be empty." end
	local profiles = self:_loadProfilesRaw()
	if profiles[normalized] == nil then
		return false, ('Profile "%s" doesn\'t exist.'):format(normalized)
	end
	local count = 0
	for _ in pairs(profiles) do count += 1 end
	if count <= 1 then
		return false, "Can't delete the last remaining profile."
	end
	profiles[normalized] = nil
	local ok, err = self:_saveProfilesRaw(profiles)
	if not ok then return false, "Couldn't delete profile: " .. tostring(err) end

	local activeOk, active = pcall(function() return self.Plugin:GetSetting(ACTIVE_PROFILE_SETTING) end)
	if activeOk and active == normalized then
		local remaining = {}
		for n in pairs(profiles) do table.insert(remaining, n) end
		table.sort(remaining, function(a, b) return string.lower(a) < string.lower(b) end)
		pcall(function() self.Plugin:SetSetting(ACTIVE_PROFILE_SETTING, remaining[1]) end)
	end
	return true, ('Deleted profile "%s".'):format(normalized)
end

-- Renames a profile in place, preserving its keywords and active status.
-- Returns (success, message).
function KeywordLibrary:RenameProfile(oldName, newName)
	local normalizedOld = normalizeProfileName(oldName)
	local normalizedNew = normalizeProfileName(newName)
	if not normalizedOld then return false, "Original profile name can't be empty." end
	if not normalizedNew then return false, "New profile name can't be empty." end
	if normalizedOld == normalizedNew then return true, "No change." end

	local profiles = self:_loadProfilesRaw()
	if profiles[normalizedOld] == nil then
		return false, ('Profile "%s" doesn\'t exist.'):format(normalizedOld)
	end
	if profiles[normalizedNew] ~= nil then
		return false, ('A profile named "%s" already exists.'):format(normalizedNew)
	end

	profiles[normalizedNew] = profiles[normalizedOld]
	profiles[normalizedOld] = nil
	local ok, err = self:_saveProfilesRaw(profiles)
	if not ok then return false, "Couldn't rename profile: " .. tostring(err) end

	local activeOk, active = pcall(function() return self.Plugin:GetSetting(ACTIVE_PROFILE_SETTING) end)
	if activeOk and active == normalizedOld then
		pcall(function() self.Plugin:SetSetting(ACTIVE_PROFILE_SETTING, normalizedNew) end)
	end
	return true, ('Renamed "%s" to "%s".'):format(normalizedOld, normalizedNew)
end

----------------------------------------------------------------
-- MULTI-SELECT PROFILES (used for scanning — you can run a find with
-- more than one profile's keywords merged into a single pass, separate
-- from the single "active" profile above which is the edit/save target
-- for the keyword text box).
----------------------------------------------------------------

local SELECTED_PROFILES_SETTING = "MaliciousFinder_SelectedProfiles"

-- Returns the list of profile names currently selected for scanning.
-- Falls back to just the active profile if nothing has been selected
-- yet (first run / pre-multi-select installs), and drops any selected
-- names that no longer exist (e.g. profile was deleted).
function KeywordLibrary:GetSelectedProfileNames()
	local profiles = self:_loadProfilesRaw()
	local ok, stored = pcall(function() return self.Plugin:GetSetting(SELECTED_PROFILES_SETTING) end)

	local selected = {}
	if ok and type(stored) == "table" and #stored > 0 then
		for _, name in ipairs(stored) do
			if profiles[name] ~= nil then table.insert(selected, name) end
		end
	end

	if #selected == 0 then
		-- Nothing valid selected yet — default to the active profile.
		selected = { self:GetActiveProfile() }
	end

	table.sort(selected, function(a, b) return string.lower(a) < string.lower(b) end)
	return selected
end

-- Replaces the full scan-selection set. Silently drops names that don't
-- exist. Refuses to save an empty set (falls back to active profile
-- instead) so a scan always has at least one profile to run with.
function KeywordLibrary:SetSelectedProfileNames(names)
	local profiles = self:_loadProfilesRaw()
	local cleaned, seen = {}, {}
	for _, name in ipairs(names or {}) do
		if profiles[name] ~= nil and not seen[name] then
			seen[name] = true
			table.insert(cleaned, name)
		end
	end
	if #cleaned == 0 then
		cleaned = { self:GetActiveProfile() }
	end
	pcall(function() self.Plugin:SetSetting(SELECTED_PROFILES_SETTING, cleaned) end)
	return cleaned
end

-- Toggles one profile's membership in the scan-selection set. Won't
-- remove the last remaining selected profile — a scan always needs at
-- least one. Returns the new selected list.
function KeywordLibrary:ToggleProfileSelected(name)
	local normalized = normalizeProfileName(name)
	if not normalized then return self:GetSelectedProfileNames() end

	local current = self:GetSelectedProfileNames()
	local currentSet, currentList = {}, {}
	for _, n in ipairs(current) do
		currentSet[n] = true
		table.insert(currentList, n)
	end

	if currentSet[normalized] then
		if #currentList <= 1 then
			-- Refuse to deselect the last remaining profile.
			return current
		end
		local filtered = {}
		for _, n in ipairs(currentList) do
			if n ~= normalized then table.insert(filtered, n) end
		end
		return self:SetSelectedProfileNames(filtered)
	else
		table.insert(currentList, normalized)
		return self:SetSelectedProfileNames(currentList)
	end
end

-- Merges + dedupes keyword lists from multiple named profiles into one
-- flat list, ready to hand to ScanEngine:ScanAll().
function KeywordLibrary:GetKeywordsForProfiles(names)
	local profiles = self:_loadProfilesRaw()
	local merged = {}
	for _, name in ipairs(names or {}) do
		local list = profiles[name]
		if list then
			for _, kw in ipairs(list) do table.insert(merged, kw) end
		end
	end
	return normalizeKeywords(merged)
end

-- Convenience: merged keywords for whatever's currently selected for
-- scanning. This is what a "Find Keywords" scan should use, NOT
-- GetKeywords() (which is single-profile, edit-target only).
function KeywordLibrary:GetKeywordsForSelectedProfiles()
	return self:GetKeywordsForProfiles(self:GetSelectedProfileNames())
end

----------------------------------------------------------------
-- ACTIVE-PROFILE KEYWORD ACCESS (existing call sites keep working)
----------------------------------------------------------------

-- Returns the current keyword list for the ACTIVE profile.
function KeywordLibrary:GetKeywords()
	local profiles = self:_loadProfilesRaw()
	local active = self:GetActiveProfile()
	return normalizeKeywords(profiles[active] or {})
end

-- Saves a raw list of keyword lines (e.g. from a UI text box) into the
-- ACTIVE profile, normalizing (trim/dedupe/sort) first.
function KeywordLibrary:SaveKeywords(rawLines)
	local cleaned = {}
	for _, line in ipairs(rawLines) do
		local trimmed = line:match("^%s*(.-)%s*$")
		if trimmed and trimmed ~= "" then table.insert(cleaned, trimmed) end
	end
	local normalized = normalizeKeywords(cleaned)
	local profiles = self:_loadProfilesRaw()
	local active = self:GetActiveProfile()
	profiles[active] = normalized
	local ok, err = self:_saveProfilesRaw(profiles)
	if not ok then return false, "Save failed: " .. tostring(err), nil end
	return true, ('Saved %d keyword(s) to "%s".'):format(#normalized, active), normalized
end

function KeywordLibrary:GetRemoteUrl()
	local ok, url = pcall(function() return self.Plugin:GetSetting(REMOTE_URL_SETTING) end)
	if ok and type(url) == "string" then return url end
	return ""
end

function KeywordLibrary:SaveRemoteUrl(url)
	pcall(function() self.Plugin:SetSetting(REMOTE_URL_SETTING, url) end)
end

local function parseRemoteKeywordText(body)
	local lines = Utils.splitLines(body)
	local keywords = {}
	for _, line in ipairs(lines) do
		local firstField = line:match("^([^,]*)") or line
		firstField = firstField:match('^%s*"?(.-)"?%s*$')
		if firstField ~= "" then table.insert(keywords, firstField) end
	end
	return keywords
end

-- Syncs a remote keyword list into the ACTIVE profile.
-- Returns (success: boolean, message: string, keywordList: {string}?)
function KeywordLibrary:SyncRemote(url)
	url = url and url:match("^%s*(.-)%s*$") or ""
	if url == "" then return false, "Enter a remote URL first." end
	if url:match("/edit") or url:match("usp=sharing") then
		return false, "That's a Google Sheets edit link, not the published CSV link. Use File > Share > Publish to web > CSV."
	end
	local ok, body = pcall(function() return HttpService:GetAsync(url) end)
	if not ok then return false, "Remote sync failed: " .. tostring(body) end
	if #body > MAX_REMOTE_RESPONSE_BYTES then
		return false, ("Remote sync aborted: response too large (%d bytes)."):format(#body)
	end
	if body:lower():match("<!doctype") or body:lower():match("<html") then
		return false, "Remote sync aborted: response looks like an HTML page, not CSV/text."
	end
	local remoteKeywords = parseRemoteKeywordText(body)
	if #remoteKeywords == 0 then return false, "Remote sync: no keywords found at URL." end
	if #remoteKeywords > MAX_REMOTE_KEYWORDS then
		return false, ("Remote sync aborted: %d entries found, exceeds safety cap of %d."):format(#remoteKeywords, MAX_REMOTE_KEYWORDS)
	end
	for _, kw in ipairs(remoteKeywords) do
		if #kw > MAX_KEYWORD_LENGTH then
			return false, "Remote sync aborted: an entry exceeded " .. MAX_KEYWORD_LENGTH .. " characters."
		end
	end
	local merged = {}
	for _, v in ipairs(self:GetKeywords()) do table.insert(merged, v) end
	for _, v in ipairs(remoteKeywords) do table.insert(merged, v) end
	merged = normalizeKeywords(merged)

	local profiles = self:_loadProfilesRaw()
	local active = self:GetActiveProfile()
	profiles[active] = merged
	local writeOk, writeErr = self:_saveProfilesRaw(profiles)
	if not writeOk then
		return false, "Remote sync fetched OK but save failed: " .. tostring(writeErr)
	end
	self:SaveRemoteUrl(url)
	return true, ('Remote sync OK — %d keyword(s) total (%d new from remote) in "%s".'):format(#merged, #remoteKeywords, active), merged
end

return KeywordLibrary
]]></ProtectedString>
