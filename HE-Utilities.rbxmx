					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- ResultsManager: owns the current scan-results array, applies dedupe,
-- and produces summary counts by result type.
local Theme = require(script.Parent.Theme)

local ResultsManager = {}
ResultsManager.__index = ResultsManager

function ResultsManager.new()
	local self = setmetatable({}, ResultsManager)
	self.Results = {}
	self.DedupeEnabled = true
	return self
end

function ResultsManager:Clear()
	self.Results = {}
end

-- Takes a raw results array (as returned by ScanEngine) and stores it,
-- applying dedupe if enabled.
function ResultsManager:SetResults(rawResults)
	if not self.DedupeEnabled then
		self.Results = rawResults
		return
	end
	local seen = {}
	local out = {}
	for _, record in ipairs(rawResults) do
		local key = record.ScriptPath .. "|" .. tostring(record.LineNumber) .. "|" .. record.ResultType
		if record.ResultType ~= "CodeMatch" and record.ResultType ~= "UIText" then
			key = key .. "|" .. record.Keyword .. "|" .. record.MatchedText
		end
		if not seen[key] then
			seen[key] = true
			table.insert(out, record)
		end
	end
	self.Results = out
end

function ResultsManager:GetResults()
	return self.Results
end

function ResultsManager:GetSummaryText()
	if #self.Results == 0 then return "No results." end
	local counts = {}
	for _, record in ipairs(self.Results) do
		counts[record.ResultType] = (counts[record.ResultType] or 0) + 1
	end
	local order = {"CodeMatch","Profanity","UserId","UIText","Attributes","Tag","MissingRef","Recognized","Flagged"}
	local parts = {}
	for _, key in ipairs(order) do
		if counts[key] then
			table.insert(parts, (Theme.SeverityLabel[key] or key) .. ": " .. counts[key])
		end
	end
	return tostring(#self.Results) .. " total   " .. table.concat(parts, "   ")
end

return ResultsManager
]]></ProtectedString>
