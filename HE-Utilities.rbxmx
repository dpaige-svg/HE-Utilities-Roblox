					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- MainController: builds the plugin widget UI. Simplified to a single
-- Results view — no manual Scan/Settings tabs, no Copy Match button, no
-- report-to-sheet feature. Scanning runs automatically on open and on a
-- recurring interval, using whatever keywords are currently in the
-- KeywordLibrary module.
local UIKit = require(script.Parent.UIKit)
local Theme = require(script.Parent.Theme)
local Utils = require(script.Parent.Utils)
local KeywordLibrary = require(script.Parent.KeywordLibrary)
local ScanEngine = require(script.Parent.ScanEngine)
local ResultsManager = require(script.Parent.ResultsManager)
local AssetSyncEngine = require(script.Parent.AssetSyncEngine)
local SignatureMatcher = require(script.Parent.SignatureMatcher)

local Color = Theme.Color
local PLUGIN_VERSION = "0.2.0"

local MainController = {}
MainController.__index = MainController

function MainController.new(plugin, ownScript)
	local self = setmetatable({}, MainController)
	self.Plugin = plugin
	self.OwnScript = ownScript
	self.ReplicatedStorage = game:GetService("ReplicatedStorage")
	self.Selection = game:GetService("Selection")

	self.KeywordLibrary = KeywordLibrary.new(plugin)
	self.ScanEngine = ScanEngine.new(ownScript)
	self.Results = ResultsManager.new()
	self.AssetSync = AssetSyncEngine.new()

	self.IsScanning = false
	self.SelectedRecord = nil
	self.ActiveFilter = "All"
	self.ExpandedGroups = {}

	-- Tracks which matches we've already notified on (by signature) so
	-- RunAutoScan only notifies on matches that are NEW since the last
	-- scan, not every match every time. Starts false so the very first
	-- scan of a session (which can surface a game's entire existing
	-- backlog) doesn't fire a wall of notifications at once.
	self._notifiedSignatures = {}
	self._hasScannedOnce = false
	return self
end

-- Result types that carry a real source-code line (as opposed to UI text,
-- attributes, or tags, which don't have a meaningful "line" to arrow at).
local NOTIFIABLE_RESULT_TYPES = {
	CodeMatch = true,
	Profanity = true,
	UserId = true,
	Recognized = true,
	Flagged = true,
}

local function recordSignature(record)
	return tostring(record.ScriptPath) .. "|" .. tostring(record.LineNumber) .. "|"
		.. tostring(record.Keyword) .. "|" .. tostring(record.MatchedText)
end

-- Pulls the actual matched source line (without the ">> N | " prefix) out
-- of a record's PreviewText, then wraps the matched substring in arrows
-- so it's obvious at a glance what tripped the scan.
local function buildArrowedLine(record)
	local matchedLine = nil
	for line in tostring(record.PreviewText or ""):gmatch("[^\n]+") do
		if line:sub(1, 3) == ">> " then
			matchedLine = line:match("^>> %d+ | (.*)$")
			break
		end
	end
	matchedLine = matchedLine or tostring(record.MatchedText or "")

	local needle = tostring(record.MatchedText or "")
	if needle ~= "" then
		local s, e = matchedLine:find(needle, 1, true)
		if s then
			return matchedLine:sub(1, s - 1) .. ">> " .. matchedLine:sub(s, e) .. " <<" .. matchedLine:sub(e + 1)
		end
	end
	return matchedLine
end

----------------------------------------------------------------
-- WIDGET SHELL (single page, no tabs)
----------------------------------------------------------------

function MainController:_buildShell()
	local widgetInfo = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, true, false, 720, 700, 560, 560)
	self.Widget = self.Plugin:CreateDockWidgetPluginGui("HEUtilitiesWidget", widgetInfo)
	self.Widget.Title = "HE-Utilities v" .. PLUGIN_VERSION

	local root = Instance.new("Frame")
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color.BG
	root.BorderSizePixel = 0
	root.Parent = self.Widget
	UIKit.padding(root, 8)
	UIKit.listLayout(root, Enum.FillDirection.Vertical, 6)

	-- Header
	local header = Instance.new("Frame")
	header.LayoutOrder = 1
	header.Size = UDim2.new(1, 0, 0, 34)
	header.BackgroundColor3 = Color.PANEL
	header.BorderSizePixel = 0
	header.Parent = root
	UIKit.corner(header, 8)
	UIKit.stroke(header, Color.BORDER)
	UIKit.padding(header, 8)
	local hList = UIKit.listLayout(header, Enum.FillDirection.Horizontal, 8)
	hList.VerticalAlignment = Enum.VerticalAlignment.Center

	local hDot = Instance.new("Frame")
	hDot.LayoutOrder = 1
	hDot.Size = UDim2.new(0, 10, 0, 10)
	hDot.BackgroundColor3 = Color.RED
	hDot.BorderSizePixel = 0
	hDot.Parent = header
	UIKit.corner(hDot, 5)

	local hTitle = UIKit.label("HE-Utilities v" .. PLUGIN_VERSION, 15, Color.TEXT, Enum.Font.GothamBold, header)
	hTitle.LayoutOrder = 2
	hTitle.Size = UDim2.new(1, -30, 1, 0)

	-- Tab bar: Results / Keywords
	local tabBar = Instance.new("Frame")
	tabBar.LayoutOrder = 2
	tabBar.Size = UDim2.new(1, 0, 0, 30)
	tabBar.BackgroundTransparency = 1
	tabBar.Parent = root
	UIKit.listLayout(tabBar, Enum.FillDirection.Horizontal, 4)

	self.TabButtons = {}
	self.TabPages = {}
	local tabNames = {"Results", "Keywords", "Send Info", "Sync"}
	for i, name in ipairs(tabNames) do
		local btn = UIKit.button("Tab_" .. name, name, Color.SURFACE, tabBar)
		btn.Size = UDim2.new(1 / #tabNames, -3, 1, 0)
		btn.LayoutOrder = i
		self.TabButtons[name] = btn
		btn.MouseButton1Click:Connect(function() self:ShowTab(name) end)
	end

	self.PageContainer = Instance.new("Frame")
	self.PageContainer.LayoutOrder = 3
	self.PageContainer.Size = UDim2.new(1, 0, 1, -76)
	self.PageContainer.BackgroundTransparency = 1
	self.PageContainer.Parent = root

	for _, name in ipairs(tabNames) do
		local page = UIKit.scroll(self.PageContainer, Color.PANEL)
		page.Size = UDim2.fromScale(1, 1)
		page.Visible = false
		UIKit.corner(page, 8)
		UIKit.stroke(page, Color.BORDER)
		UIKit.padding(page, 10)
		UIKit.listLayout(page, Enum.FillDirection.Vertical, 8)
		self.TabPages[name] = page
	end

	-- Backwards-compatible alias: existing Results-tab builder code refers
	-- to self.Page as the container it builds into.
	self.Page = self.TabPages.Results
end

function MainController:ShowTab(name)
	for tabName, page in pairs(self.TabPages) do
		page.Visible = (tabName == name)
		self.TabButtons[tabName].BackgroundColor3 = (tabName == name) and Color.BLUE_DIM or Color.SURFACE
	end
end

----------------------------------------------------------------
-- RESULTS PAGE
----------------------------------------------------------------

function MainController:_buildKeywordsTab()
	local page = self.TabPages.Keywords

	----------------------------------------------------------------
	-- PROFILES
	----------------------------------------------------------------
	UIKit.sectionLabel("Profile", page, 1)

	self.ProfileRow = Instance.new("Frame")
	self.ProfileRow.LayoutOrder = 2
	self.ProfileRow.Size = UDim2.new(1, 0, 0, 30)
	self.ProfileRow.BackgroundTransparency = 1
	self.ProfileRow.Parent = page
	local profileLayout = UIKit.listLayout(self.ProfileRow, Enum.FillDirection.Horizontal, 4)
	profileLayout.SortOrder = Enum.SortOrder.LayoutOrder

	local newProfileRow = UIKit.row(page, 3, 30)
	self.NewProfileField = UIKit.textField(newProfileRow, "New profile name...")
	self.NewProfileField.Size = UDim2.new(0.7, -2, 1, 0)
	self.CreateProfileButton = UIKit.button("CreateProfile", "+ Create", Color.BLUE_DIM, newProfileRow)
	self.CreateProfileButton.Size = UDim2.new(0.3, -2, 1, 0)

	local manageProfileRow = UIKit.row(page, 4, 30)
	self.RenameProfileButton = UIKit.button("RenameProfile", "Rename Active", Color.SURFACE, manageProfileRow)
	self.RenameProfileButton.Size = UDim2.new(0.5, -2, 1, 0)
	self.DeleteProfileButton = UIKit.button("DeleteProfile", "Delete Active", Color.SURFACE, manageProfileRow)
	self.DeleteProfileButton.Size = UDim2.new(0.5, -2, 1, 0)

	self.ProfileStatusLabel = UIKit.label("", 11, Color.MUTED, Enum.Font.Gotham, page)
	self.ProfileStatusLabel.LayoutOrder = 5
	self.ProfileStatusLabel.Size = UDim2.new(1, 0, 0, 18)
	self.ProfileStatusLabel.TextWrapped = true

	self.CreateProfileButton.MouseButton1Click:Connect(function()
		local ok, msg = self.KeywordLibrary:CreateProfile(self.NewProfileField.Text)
		self.ProfileStatusLabel.Text = msg
		if ok then
			self.NewProfileField.Text = ""
			self:_refreshProfileUI()
		end
	end)

	self.RenameProfileButton.MouseButton1Click:Connect(function()
		local newName = self.NewProfileField.Text
		if newName == nil or newName:match("^%s*$") then
			self.ProfileStatusLabel.Text = "Type the new name in the field above, then press Rename Active."
			return
		end
		local active = self.KeywordLibrary:GetActiveProfile()
		local ok, msg = self.KeywordLibrary:RenameProfile(active, newName)
		self.ProfileStatusLabel.Text = msg
		if ok then
			self.NewProfileField.Text = ""
			self:_refreshProfileUI()
		end
	end)

	self.DeleteProfileButton.MouseButton1Click:Connect(function()
		local active = self.KeywordLibrary:GetActiveProfile()
		local ok, msg = self.KeywordLibrary:DeleteProfile(active)
		self.ProfileStatusLabel.Text = msg
		if ok then
			self:_refreshProfileUI()
		end
	end)

	----------------------------------------------------------------
	-- KEYWORDS (for the active profile)
	----------------------------------------------------------------
	UIKit.sectionLabel("Keywords / Lua Patterns", page, 6)
	local keywordScroll = UIKit.scroll(page, Color.SURFACE)
	keywordScroll.LayoutOrder = 7
	keywordScroll.Size = UDim2.new(1, 0, 0, 320)
	UIKit.corner(keywordScroll, 6)
	UIKit.stroke(keywordScroll, Color.BORDER)
	self.KeywordBox = UIKit.codeBox(keywordScroll, true)
	self.KeywordBox.PlaceholderText = "One keyword or Lua pattern per line..."

	-- Auto-save: debounced so it doesn't save on every keystroke, just
	-- shortly after the user stops typing.
	self.KeywordBox:GetPropertyChangedSignal("Text"):Connect(function()
		self._pendingKeywordSave = true
		task.delay(1, function()
			if self._pendingKeywordSave then
				self._pendingKeywordSave = false
				local lines = Utils.splitLines(self.KeywordBox.Text)
				local ok, msg = self.KeywordLibrary:SaveKeywords(lines)
				if self.KeywordStatusLabel then
					self.KeywordStatusLabel.Text = msg
				end
			end
		end)
	end)

	local btnRow = UIKit.row(page, 8, 30)
	self.SaveKeywordsButton = UIKit.button("SaveKeywords", "Save", Color.BLUE_DIM, btnRow)
	self.SaveKeywordsButton.Size = UDim2.new(0.5, -2, 1, 0)
	self.ReloadKeywordsButton = UIKit.button("ReloadKeywords", "Reload", Color.SURFACE, btnRow)
	self.ReloadKeywordsButton.Size = UDim2.new(0.5, -2, 1, 0)

	self.KeywordStatusLabel = UIKit.label("", 11, Color.MUTED, Enum.Font.Gotham, page)
	self.KeywordStatusLabel.LayoutOrder = 9
	self.KeywordStatusLabel.Size = UDim2.new(1, 0, 0, 18)
	self.KeywordStatusLabel.TextWrapped = true

	self.SaveKeywordsButton.MouseButton1Click:Connect(function()
		local lines = Utils.splitLines(self.KeywordBox.Text)
		local ok, msg, saved = self.KeywordLibrary:SaveKeywords(lines)
		self.KeywordStatusLabel.Text = msg
		if ok and saved then
			self.KeywordBox.Text = table.concat(saved, "\n")
		end
	end)

	self.ReloadKeywordsButton.MouseButton1Click:Connect(function()
		local count = self:_loadKeywordsFromModule()
		self.KeywordStatusLabel.Text = ("Reloaded %d keyword(s) from module."):format(count)
	end)

	self:_refreshProfileUI()
end

-- Rebuilds the profile button row from KeywordLibrary's profile list,
-- highlighting whichever one is active, and reloads the keyword box to
-- match. Call after any create/rename/delete/switch.
-- Profile row shows two independent things per button:
--   - a checkmark + green outline = this profile is INCLUDED when running
--     a keyword find (multi-select; more than one can be checked at once)
--   - a blue-filled background = this is the single EDIT TARGET whose
--     keyword list is loaded into the text box below for viewing/editing
-- Clicking a button toggles its scan-inclusion AND makes it the edit
-- target, so the common case (click a profile, see + tweak its keywords,
-- have it included in the next scan) stays a single click.
function MainController:_refreshProfileUI()
	for _, child in ipairs(self.ProfileRow:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local names = self.KeywordLibrary:GetProfileNames()
	local active = self.KeywordLibrary:GetActiveProfile()
	local selectedSet = {}
	for _, n in ipairs(self.KeywordLibrary:GetSelectedProfileNames()) do
		selectedSet[n] = true
	end

	for i, name in ipairs(names) do
		local isSelected = selectedSet[name] == true
		local label = (isSelected and "\226\156\147 " or "") .. name
		local btn = UIKit.button("Profile_" .. name, label, (name == active) and Color.BLUE_DIM or Color.SURFACE, self.ProfileRow)
		btn.LayoutOrder = i
		btn.AutomaticSize = Enum.AutomaticSize.X
		btn.Size = UDim2.new(0, 0, 1, 0)
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0, 10)
		padding.PaddingRight = UDim.new(0, 10)
		padding.Parent = btn

		if isSelected then
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color.GREEN
			stroke.Thickness = 1.5
			stroke.Parent = btn
		end

		btn.MouseButton1Click:Connect(function()
			self.KeywordLibrary:ToggleProfileSelected(name)
			local ok, msg = self.KeywordLibrary:SetActiveProfile(name)
			if ok then
				self.ProfileStatusLabel.Text = msg
			end
			self:_refreshProfileUI()
		end)
	end

	local selectedNames = self.KeywordLibrary:GetSelectedProfileNames()
	self.ProfileStatusLabel.Text = "Scanning with: " .. table.concat(selectedNames, ", ")

	self:_loadKeywordsFromModule()
end

function MainController:_loadKeywordsFromModule()
	local moduleKeywords = self.KeywordLibrary:GetKeywords()
	self.KeywordBox.Text = table.concat(moduleKeywords, "\n")
	return #moduleKeywords
end

----------------------------------------------------------------
-- SEND INFO (post a typed message to a Google Sheet via Apps Script)
----------------------------------------------------------------

local SHEET_WEBHOOK_URL_SETTING = "MaliciousFinder_SheetWebhookUrl"

-- Set your Google Apps Script Web App URL here to have it pre-filled
-- automatically. Leave as "" to require users to paste their own.
local DEFAULT_SHEET_WEBHOOK_URL = ""

function MainController:_buildSendInfoTab()
	local page = self.TabPages["Send Info"]

	self.SheetUrlField = UIKit.textField(page, "Paste your Apps Script Web App URL...")
	self.SheetUrlField.LayoutOrder = 1
	self.SheetUrlField.Size = UDim2.new(1, 0, 0, 32)

	local ok, savedUrl = pcall(function() return self.Plugin:GetSetting(SHEET_WEBHOOK_URL_SETTING) end)
	if ok and type(savedUrl) == "string" and savedUrl ~= "" then
		self.SheetUrlField.Text = savedUrl
	else
		self.SheetUrlField.Text = DEFAULT_SHEET_WEBHOOK_URL
	end

	-- The webhook URL is a backend detail, not something users see or
	-- edit — always hidden.
	self.SheetUrlField.Visible = false

	UIKit.sectionLabel("Message", page, 3)
	local messageScroll = UIKit.scroll(page, Color.SURFACE)
	messageScroll.LayoutOrder = 4
	messageScroll.Size = UDim2.new(1, 0, 0, 160)
	UIKit.corner(messageScroll, 6)
	UIKit.stroke(messageScroll, Color.BORDER)
	self.SendInfoBox = UIKit.codeBox(messageScroll, true)
	self.SendInfoBox.PlaceholderText = "Type what you want to send..."

	self.SendInfoButton = UIKit.button("SendInfo", "Send to Google Sheet", Color.BLUE_DIM, page)
	self.SendInfoButton.LayoutOrder = 5
	self.SendInfoButton.Size = UDim2.new(1, 0, 0, 32)

	self.SendInfoStatusLabel = UIKit.label("", 11, Color.MUTED, Enum.Font.Gotham, page)
	self.SendInfoStatusLabel.LayoutOrder = 6
	self.SendInfoStatusLabel.Size = UDim2.new(1, 0, 0, 18)
	self.SendInfoStatusLabel.TextWrapped = true

	self.SendInfoButton.MouseButton1Click:Connect(function()
		local url = self.SheetUrlField.Text:match("^%s*(.-)%s*$")
		local message = self.SendInfoBox.Text:match("^%s*(.-)%s*$")

		if url == "" then
			self.SendInfoStatusLabel.Text = "Enter a Google Apps Script Web App URL first."
			return
		end
		if message == "" then
			self.SendInfoStatusLabel.Text = "Type a message first."
			return
		end

		pcall(function() self.Plugin:SetSetting(SHEET_WEBHOOK_URL_SETTING, url) end)

		self.SendInfoStatusLabel.Text = "Sending..."
		local HttpService = game:GetService("HttpService")
		local payload = HttpService:JSONEncode({
			message = message,
			sentAt = os.date("%Y-%m-%d %H:%M:%S"),
		})

		local ok, result = pcall(function()
			return HttpService:PostAsync(url, payload, Enum.HttpContentType.ApplicationJson)
		end)

		if ok then
			self.SendInfoStatusLabel.Text = "Sent successfully."
			self.SendInfoBox.Text = ""
		else
			self.SendInfoStatusLabel.Text = "Send failed: " .. tostring(result)
		end
	end)
end

----------------------------------------------------------------
-- SYNC TAB (AssetSync dashboard: status / last sync / scan)
----------------------------------------------------------------

function MainController:_buildSyncTab()
	local page = self.TabPages.Sync

	UIKit.sectionLabel("Auto-Sync", page, 1)

	local toggleRow = UIKit.row(page, 2, 30)
	self.SyncToggleButton = UIKit.button("SyncToggle", "Enabled", Color.GREEN, toggleRow)
	self.SyncToggleButton.Size = UDim2.fromScale(1, 1)

	self.SyncStatusLabel = UIKit.label("\226\151\143 Auto-Sync: ENABLED", 14, Color.GREEN, Enum.Font.GothamBold, page)
	self.SyncStatusLabel.LayoutOrder = 3
	self.SyncStatusLabel.Size = UDim2.new(1, 0, 0, 22)

	UIKit.sectionLabel("Last Sync", page, 4)
	self.SyncDetailLabel = UIKit.label("No syncs yet", 12, Color.MUTED, Enum.Font.Gotham, page)
	self.SyncDetailLabel.LayoutOrder = 5
	self.SyncDetailLabel.Size = UDim2.new(1, 0, 0, 18)
	self.SyncDetailLabel.TextWrapped = true

	UIKit.sectionLabel("Last Scan", page, 6)
	self.SyncScanLabel = UIKit.label("No scans yet", 12, Color.MUTED, Enum.Font.Gotham, page)
	self.SyncScanLabel.LayoutOrder = 7
	self.SyncScanLabel.Size = UDim2.new(1, 0, 0, 18)
	self.SyncScanLabel.TextWrapped = true

	UIKit.sectionLabel("Descendant Removed", page, 8)
	self.SyncRemovalLabel = UIKit.label("No removals detected", 12, Color.MUTED, Enum.Font.Gotham, page)
	self.SyncRemovalLabel.LayoutOrder = 9
	self.SyncRemovalLabel.Size = UDim2.new(1, 0, 0, 18)
	self.SyncRemovalLabel.TextWrapped = true

	self.SyncToggleButton.MouseButton1Click:Connect(function()
		self.AssetSync:SetEnabled(not self.AssetSync.Enabled)
	end)

	self.AssetSync:Start({
		OnStatusChange = function(enabled)
			self.SyncToggleButton.Text = enabled and "Enabled" or "Disabled"
			self.SyncToggleButton.BackgroundColor3 = enabled and Color.GREEN or Color.RED_DIM
			self.SyncStatusLabel.Text = enabled
				and "\226\151\143 Auto-Sync: ENABLED"
				or "\226\151\143 Auto-Sync: DISABLED"
			self.SyncStatusLabel.TextColor3 = enabled and Color.GREEN or Color.RED
		end,
		OnDetailChange = function(text, isError)
			self.SyncDetailLabel.Text = text
			self.SyncDetailLabel.TextColor3 = isError and Color.AMBER or Color.MUTED
		end,
		OnScanChange = function(text, hadIssues)
			self.SyncScanLabel.Text = "\226\151\143 " .. text
			self.SyncScanLabel.TextColor3 = hadIssues and Color.AMBER or Color.GREEN
		end,
		OnRemovalChange = function(text, wasRemoval)
			self.SyncRemovalLabel.Text = wasRemoval and ("\226\151\143 " .. text) or text
			self.SyncRemovalLabel.TextColor3 = wasRemoval and Color.RED or Color.MUTED
		end,
	})

end

function MainController:_buildResultsPage()
	local page = self.Page

	self.StatusLabel = Instance.new("TextLabel")
	self.StatusLabel.LayoutOrder = 1
	self.StatusLabel.Size = UDim2.new(1, 0, 0, 32)
	self.StatusLabel.BackgroundTransparency = 1
	self.StatusLabel.Text = "Ready."
	self.StatusLabel.TextColor3 = Color.MUTED
	self.StatusLabel.Font = Enum.Font.Gotham
	self.StatusLabel.TextSize = 12
	self.StatusLabel.TextWrapped = true
	self.StatusLabel.TextXAlignment = Enum.TextXAlignment.Left
	self.StatusLabel.TextYAlignment = Enum.TextYAlignment.Top
	self.StatusLabel.Parent = page

	self.SummaryLabel = UIKit.label("No scan run yet.", 12, Color.MUTED, Enum.Font.GothamBold, page)
	self.SummaryLabel.LayoutOrder = 2
	self.SummaryLabel.Size = UDim2.new(1, 0, 0, 30)
	self.SummaryLabel.TextWrapped = true

	UIKit.sectionLabel("Results", page, 3)

	-- Filter tabs: switch which result type is shown without rescanning.
	self.FilterTabBar = UIKit.row(page, 4, 26)
	self.FilterButtons = {}
	local filterOptions = {
		{Key = "All", Label = "All"},
		{Key = "CodeMatch", Label = "Code"},
		{Key = "UIText", Label = "UI Text"},
		{Key = "Attributes", Label = "Attributes"},
		{Key = "Tag", Label = "Tags"},
		{Key = "Recognized", Label = "Recognized"},
		{Key = "Flagged", Label = "Flagged"},
	}
	for _, opt in ipairs(filterOptions) do
		local btn = UIKit.button("Filter_" .. opt.Key, opt.Label, Color.SURFACE, self.FilterTabBar)
		btn.Size = UDim2.new(1 / #filterOptions, -3, 1, 0)
		btn.TextSize = 11
		btn.MouseButton1Click:Connect(function()
			self.ActiveFilter = opt.Key
			self:_refreshResultsUI()
		end)
		self.FilterButtons[opt.Key] = btn
	end

	self.ResultsListFrame = UIKit.scroll(page, Color.SURFACE)
	self.ResultsListFrame.LayoutOrder = 5
	self.ResultsListFrame.Size = UDim2.new(1, 0, 0, 240)
	UIKit.corner(self.ResultsListFrame, 6)
	UIKit.stroke(self.ResultsListFrame, Color.BORDER)
	UIKit.padding(self.ResultsListFrame, 4)
	UIKit.listLayout(self.ResultsListFrame, Enum.FillDirection.Vertical, 4)

	-- Open in Editor sits directly below the results list now.
	local actRow = UIKit.row(page, 6, 32)
	self.OpenButton = UIKit.button("OpenScript", "Open in Editor", Color.BLUE_DIM, actRow)
	self.OpenButton.Size = UDim2.fromScale(1, 1)
	self.OpenButton.MouseButton1Click:Connect(function() self:_openSelectedScript() end)

	UIKit.sectionLabel("Match Details", page, 7)
	local pathChip = Instance.new("Frame")
	pathChip.LayoutOrder = 8
	pathChip.Size = UDim2.new(1, 0, 0, 34)
	pathChip.BackgroundColor3 = Color.SURFACE
	pathChip.BorderSizePixel = 0
	pathChip.Parent = page
	UIKit.corner(pathChip, 6)
	UIKit.stroke(pathChip, Color.BORDER)
	UIKit.padding(pathChip, 6)
	self.PathLabel = UIKit.label("No result selected", 12, Color.TEXT, Enum.Font.Code, pathChip)
	self.PathLabel.Size = UDim2.fromScale(1, 1)
	self.PathLabel.TextTruncate = Enum.TextTruncate.AtEnd

	local metaRow = UIKit.row(page, 9, 26)
	self.LineLabel = UIKit.label("Line: -", 12, Color.MUTED, Enum.Font.GothamBold, metaRow)
	self.LineLabel.Size = UDim2.new(0.3, 0, 1, 0)
	self.KeywordLabel = UIKit.label("Keyword: -", 12, Color.MUTED, Enum.Font.GothamBold, metaRow)
	self.KeywordLabel.Size = UDim2.new(0.68, 0, 1, 0)
	self.KeywordLabel.TextTruncate = Enum.TextTruncate.AtEnd

	local matchChip = Instance.new("Frame")
	matchChip.LayoutOrder = 10
	matchChip.Size = UDim2.new(1, 0, 0, 34)
	matchChip.BackgroundColor3 = Color3.fromRGB(40, 28, 10)
	matchChip.BorderSizePixel = 0
	matchChip.Parent = page
	UIKit.corner(matchChip, 6)
	UIKit.stroke(matchChip, Color3.fromRGB(80, 55, 15))
	UIKit.padding(matchChip, 8)
	self.MatchLabel = UIKit.label("Match: -", 12, Color.AMBER, Enum.Font.Code, matchChip)
	self.MatchLabel.Size = UDim2.fromScale(1, 1)
	self.MatchLabel.TextWrapped = true
	self.MatchLabel.TextTruncate = Enum.TextTruncate.AtEnd

	UIKit.sectionLabel("Code Preview", page, 11)
	local previewScroll = UIKit.scroll(page, Color3.fromRGB(10, 12, 18))
	previewScroll.LayoutOrder = 12
	previewScroll.Size = UDim2.new(1, 0, 0, 170)
	UIKit.corner(previewScroll, 6)
	UIKit.stroke(previewScroll, Color.BORDER)
	self.PreviewBox = UIKit.codeBox(previewScroll, true)
	self.PreviewBox.Text = "-- Select a result above to preview code"
	self.PreviewBox.TextColor3 = Color3.fromRGB(180, 200, 220)
end

function MainController:_selectRecord(record, rowFrame)
	if self.SelectedRowFrame then self.SelectedRowFrame.BackgroundColor3 = Color.SURFACE end
	if rowFrame then
		rowFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 62)
		self.SelectedRowFrame = rowFrame
	end
	self.SelectedRecord = record
	local obj = record.ScriptObject
	local deleted = (obj == nil) or (obj.Parent == nil)

	self.PathLabel.Text = deleted and (record.ScriptPath .. "  [Object deleted]") or record.ScriptPath
	self.PathLabel.TextColor3 = deleted and Color.RED or Color.TEXT
	self.LineLabel.Text = "Line: " .. tostring(record.LineNumber)
	self.KeywordLabel.Text = "Keyword: " .. tostring(record.Keyword)
	self.MatchLabel.Text = "Match: " .. tostring(record.MatchedText)
	self.PreviewBox.Text = deleted
		and "-- This object no longer exists in the game (deleted or moved).\n-- Preview unavailable."
		or record.PreviewText

	if deleted then
		self.StatusLabel.Text = "This result's object was deleted or moved — no longer in the game."
	else
		self.StatusLabel.Text = ("Selected %s at line %d"):format(obj.Name, record.LineNumber)
	end
end

local function isRecordDeleted(record)
	local obj = record.ScriptObject
	return (obj == nil) or (obj.Parent == nil)
end

-- Groups visible records by script/object so a script with many matches
-- collapses into one row instead of flooding the list. Preserves the
-- order scripts first appeared in.
local function groupRecordsByScript(records)
	local groups, order = {}, {}
	for _, record in ipairs(records) do
		local key = record.ScriptPath
		if not groups[key] then
			groups[key] = { Path = key, Object = record.ScriptObject, Records = {} }
			table.insert(order, key)
		end
		table.insert(groups[key].Records, record)
	end
	local ordered = {}
	for _, key in ipairs(order) do table.insert(ordered, groups[key]) end
	return ordered
end

function MainController:_refreshResultsUI()
	for _, child in ipairs(self.ResultsListFrame:GetChildren()) do
		if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
	end
	self.SelectedRowFrame = nil
	self.SummaryLabel.Text = self.Results:GetSummaryText()

	-- Highlight the active filter tab
	for key, btn in pairs(self.FilterButtons) do
		btn.BackgroundColor3 = (key == self.ActiveFilter) and Color.BLUE_DIM or Color.SURFACE
	end

	local allRecords = self.Results:GetResults()
	local visibleRecords = {}
	for _, record in ipairs(allRecords) do
		if self.ActiveFilter == "All" or record.ResultType == self.ActiveFilter then
			table.insert(visibleRecords, record)
		end
	end

	if #visibleRecords == 0 then
		local emptyLbl = UIKit.label(
			(#allRecords == 0) and "No results." or "No results for this filter.",
			11, Color.MUTED, Enum.Font.Gotham, self.ResultsListFrame)
		emptyLbl.Size = UDim2.new(1, 0, 0, 24)
		return
	end

	local groups = groupRecordsByScript(visibleRecords)
	local layoutOrder = 0

	for _, group in ipairs(groups) do
		layoutOrder += 1
		local deleted = isRecordDeleted({ScriptObject = group.Object})
		local firstRecord = group.Records[1]
		local rowColor = deleted and Color.DIM or (Theme.ResultTypeColor[firstRecord.ResultType] or Color.MUTED)
		local isExpanded = self.ExpandedGroups[group.Path] == true
		local multipleMatches = #group.Records > 1
		local isNew = self._pendingHighlight and self._pendingHighlight[group.Path] == true

		local headerHeight = deleted and 44 or 28
		local header = Instance.new("Frame")
		header.Name = "GroupHeader" .. layoutOrder
		header.LayoutOrder = layoutOrder
		header.Size = UDim2.new(1, 0, 0, headerHeight)
		header.BackgroundColor3 = isNew and Color3.fromRGB(70, 35, 35) or Color.SURFACE
		header.BackgroundTransparency = deleted and 0.35 or 0
		header.BorderSizePixel = 0
		header.Parent = self.ResultsListFrame
		UIKit.corner(header, 5)

		local bar = Instance.new("Frame")
		bar.Size = UDim2.new(0, 3, 1, 0)
		bar.BackgroundColor3 = rowColor
		bar.BorderSizePixel = 0
		bar.Parent = header
		UIKit.corner(bar, 2)

		local scriptName = group.Object and group.Object.Name or (firstRecord.ScriptPath:match("[^%.]+$") or "Unknown")
		local countBadge = multipleMatches and ("  ×" .. #group.Records) or ""
		local expandArrow = multipleMatches and (isExpanded and "[-] " or "[+] ") or "     "
		local nameLbl = UIKit.label(expandArrow .. scriptName .. countBadge, 12, rowColor, Enum.Font.GothamBold, header)
		nameLbl.Position = UDim2.new(0, 10, 0, 0)
		nameLbl.Size = UDim2.new(0.4, -10, 1, 0)
		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
		if deleted then
			nameLbl.Size = UDim2.new(0.4, -10, 0, 16)
			nameLbl.Position = UDim2.new(0, 10, 0, 4)
		end

		local typeList = {}
		local seenTypes = {}
		for _, r in ipairs(group.Records) do
			if not seenTypes[r.ResultType] then
				seenTypes[r.ResultType] = true
				table.insert(typeList, Theme.SeverityLabel[r.ResultType] or r.ResultType)
			end
		end
		local detailLbl = UIKit.label(table.concat(typeList, ", "), 10, rowColor, Enum.Font.Code, header)
		detailLbl.TextXAlignment = Enum.TextXAlignment.Left
		detailLbl.Position = UDim2.new(0.4, 4, 0, 0)
		detailLbl.Size = UDim2.new(0.6, -12, 1, 0)
		detailLbl.TextTruncate = Enum.TextTruncate.AtEnd
		if deleted then
			detailLbl.Size = UDim2.new(0.6, -12, 0, 16)
			detailLbl.Position = UDim2.new(0.4, 4, 0, 4)
		end

		if deleted then
			local deletedLbl = UIKit.label("Object not found — deleted or moved", 10, Color.RED, Enum.Font.GothamBold, header)
			deletedLbl.Position = UDim2.new(0, 10, 0, 22)
			deletedLbl.Size = UDim2.new(1, -16, 0, 14)
		end

		local clickBtn = Instance.new("TextButton")
		clickBtn.BackgroundTransparency = 1
		clickBtn.Text = ""
		clickBtn.Size = UDim2.fromScale(1, 1)
		clickBtn.ZIndex = 5
		clickBtn.Parent = header
		local DOUBLE_CLICK_WINDOW = 0.35
		local lastClickTime = 0
		clickBtn.MouseButton1Click:Connect(function()
			if self._pendingHighlight and self._pendingHighlight[group.Path] then
				self._pendingHighlight[group.Path] = nil
				header.BackgroundColor3 = Color.SURFACE
			end
			self:_selectRecord(firstRecord, header)
			local now = os.clock()
			if (now - lastClickTime) <= DOUBLE_CLICK_WINDOW then
				lastClickTime = 0
				self:_openSelectedScript()
			else
				lastClickTime = now
				if multipleMatches then
					self.ExpandedGroups[group.Path] = not isExpanded
					self:_refreshResultsUI()
				end
			end
		end)

		if isExpanded and multipleMatches then
			for j, record in ipairs(group.Records) do
				layoutOrder += 1
				local subRow = Instance.new("Frame")
				subRow.Name = "SubRow" .. layoutOrder
				subRow.LayoutOrder = layoutOrder
				subRow.Size = UDim2.new(1, 0, 0, 30)
				subRow.BackgroundColor3 = Color3.fromRGB(24, 24, 33)
				subRow.BorderSizePixel = 0
				subRow.Parent = self.ResultsListFrame
				UIKit.corner(subRow, 4)

				local subColor = Theme.ResultTypeColor[record.ResultType] or Color.MUTED
				local subLbl = UIKit.label(
					("    Line %d — %s [%s]"):format(record.LineNumber, tostring(record.Keyword), Theme.SeverityLabel[record.ResultType] or record.ResultType),
					10, subColor, Enum.Font.Code, subRow)
				subLbl.Position = UDim2.new(0, 8, 0, 0)
				subLbl.Size = UDim2.new(1, -12, 1, 0)
				subLbl.TextTruncate = Enum.TextTruncate.AtEnd

				local subClick = Instance.new("TextButton")
				subClick.BackgroundTransparency = 1
				subClick.Text = ""
				subClick.Size = UDim2.fromScale(1, 1)
				subClick.ZIndex = 5
				subClick.Parent = subRow
				local subLastClick = 0
				subClick.MouseButton1Click:Connect(function()
					self:_selectRecord(record, subRow)
					local now = os.clock()
					if (now - subLastClick) <= DOUBLE_CLICK_WINDOW then
						subLastClick = 0
						self:_openSelectedScript()
					else
						subLastClick = now
					end
				end)
			end
		end
	end
end

function MainController:_openSelectedScript()
	if not self.SelectedRecord then self.StatusLabel.Text = "Select a result first." return end
	local obj = self.SelectedRecord.ScriptObject
	if not obj or obj.Parent == nil then self.StatusLabel.Text = "Object no longer exists." return end
	self.Selection:Set({obj})
	if Utils.isLuaScript(obj) then
		local ok, err = pcall(function() self.Plugin:OpenScript(obj, self.SelectedRecord.LineNumber) end)
		self.StatusLabel.Text = ok
			and ("Opened %s | Line %d"):format(obj.Name, self.SelectedRecord.LineNumber)
			or ("Could not open script: " .. tostring(err))
	else
		self.StatusLabel.Text = ("Selected %s in Explorer"):format(obj:GetFullName())
	end
end

----------------------------------------------------------------
-- NEW-MATCH HIGHLIGHTING (shown directly in the Results tab)
----------------------------------------------------------------

-- Marks which scripts have a brand-new notifiable match since the last
-- scan and switches to the Results tab so it's visible immediately. Used
-- instead of a separate popup — a CoreGui overlay wasn't reliably
-- rendering text in this environment, so this reuses the widget's own
-- working UI instead. Rows stay highlighted until clicked.
function MainController:_flagNewMatches(combined)
	local currentSignatures = {}
	local newScriptPaths = {}
	for _, record in ipairs(combined) do
		if NOTIFIABLE_RESULT_TYPES[record.ResultType] then
			local sig = recordSignature(record)
			currentSignatures[sig] = record
			if self._hasScannedOnce and not self._notifiedSignatures[sig] then
				newScriptPaths[record.ScriptPath] = true
			end
		end
	end

	if next(newScriptPaths) then
		self._pendingHighlight = self._pendingHighlight or {}
		for path in pairs(newScriptPaths) do
			self._pendingHighlight[path] = true
		end
		self:ShowTab("Results")
	end

	self._notifiedSignatures = currentSignatures
	self._hasScannedOnce = true
end
----------------------------------------------------------------
-- AUTO SCAN (runs on open + interval, no manual controls)
----------------------------------------------------------------

function MainController:RunAutoScan()
	if self.IsScanning then return end
	self.IsScanning = true
	self.StatusLabel.Text = "Scanning..."
	task.wait()

	-- Run keyword/UI-text scan (this already covers TextLabel/TextButton/
	-- TextBox text via isTextUIObject), plus Attributes and Tags, and
	-- merge everything into one combined result set.
	-- Use the merged keyword set from every profile currently selected for
	-- scanning (multi-select), not just the single edit-target profile.
	local keywords = self.KeywordLibrary:GetKeywordsForSelectedProfiles()
	local combined = {}
	local scannedTotal, foundTotal = 0, 0

	local allResults, _, allScanned, allFound = self.ScanEngine:ScanAll(keywords)
	for _, r in ipairs(allResults or {}) do table.insert(combined, r) end
	scannedTotal += allScanned or 0
	foundTotal += allFound or 0

	local attrResults, _, attrScanned, attrFound = self.ScanEngine:ScanAttributes()
	for _, r in ipairs(attrResults or {}) do table.insert(combined, r) end
	scannedTotal += attrScanned or 0
	foundTotal += attrFound or 0

	local tagResults, _, tagScanned, tagFound = self.ScanEngine:ScanTags()
	for _, r in ipairs(tagResults or {}) do table.insert(combined, r) end
	scannedTotal += tagScanned or 0
	foundTotal += tagFound or 0

	-- High-confidence signatures are bundled in the plugin and require no
	-- companion program, HTTP access, or Rojo connection.
	local signatureResults, _, signatureScanned, signatureFound = SignatureMatcher.ScanAll(self.OwnScript)
	for _, r in ipairs(signatureResults or {}) do table.insert(combined, r) end
	scannedTotal += signatureScanned or 0
	foundTotal += signatureFound or 0

	self:_flagNewMatches(combined)
	self.Results:SetResults(combined)
	local selectedProfiles = self.KeywordLibrary:GetSelectedProfileNames()
	local profileLabel = table.concat(selectedProfiles, ", ")
	self.StatusLabel.Text = ("Done. Profiles: %s | Scanned: %d | Found: %d (code/text + attributes + tags)"):format(profileLabel, scannedTotal, foundTotal)
	self:_refreshResultsUI()
	self.IsScanning = false
end

----------------------------------------------------------------
-- TOOLBAR + STARTUP
----------------------------------------------------------------

function MainController:Init()
	local toolbar = self.Plugin:CreateToolbar("Malicious Finder")
	local toggleButton = toolbar:CreateButton(
		"Malicious Finder",
		"Scans scripts for suspicious keywords and patterns",
		"rbxassetid://4458901886"
	)
	toggleButton.ClickableWhenViewportHidden = true

	self:_buildShell()
	self:_buildResultsPage()
	self:_buildKeywordsTab()
	self:_buildSendInfoTab()
	self:_buildSyncTab()
	self:ShowTab("Results")

	toggleButton.Click:Connect(function()
		self.Widget.Enabled = not self.Widget.Enabled
	end)
	self.Widget.Enabled = true

	task.spawn(function()
		local remoteUrl = self.KeywordLibrary:GetRemoteUrl()
		if remoteUrl ~= "" then
			self.StatusLabel.Text = "Syncing remote keywords..."
			self.KeywordLibrary:SyncRemote(remoteUrl)
		end
		self.StatusLabel.Text = "Scanning..."
		task.wait(0.5)
		self:RunAutoScan()
	end)

	self:_wireLiveRescan()
end

-- Rescans whenever anything is added to or removed from any real content
-- directory in the game (Workspace, ServerScriptService, ServerStorage,
-- ReplicatedStorage, StarterGui, StarterPlayer, Lighting, SoundService),
-- instead of polling on a timer. Deliberately does NOT listen on CoreGui
-- or the whole `game` tree — Studio's own editor internals (selection
-- highlights, drag adornments, hover outlines) live under CoreGui and
-- fire constant Added/Removing events that have nothing to do with the
-- actual place content, which is what caused continuous rescanning.
-- Rapid bursts of changes (e.g. inserting a model with many parts) are
-- debounced into a single rescan shortly after things settle.
function MainController:_scheduleRescan()
	if self._pendingRescan then return end
	self._pendingRescan = true
	local DEBOUNCE_SECONDS = 0.75
	task.delay(DEBOUNCE_SECONDS, function()
		self._pendingRescan = false
		if self.Widget.Parent ~= nil and not self.IsScanning then
			-- Something was added — re-sync keywords from the Google Sheet
			-- (if a remote URL is configured) before rescanning, so newly
			-- added rows on the sheet are picked up too.
			local remoteUrl = self.KeywordLibrary:GetRemoteUrl()
			if remoteUrl ~= "" then
				self.KeywordLibrary:SyncRemote(remoteUrl)
			end
			self:RunAutoScan()
		end
	end)
end

-- Connects a Source-property listener to every script we haven't already
-- attached to, so EDITING an existing script's code (not just adding/
-- removing instances) also triggers a rescan. Safe to call repeatedly —
-- already-tracked scripts are skipped.
-- Wires a Source-change listener onto a SINGLE script object. O(1) —
-- safe to call once per newly-added script (e.g. from DescendantAdded)
-- without re-walking the whole place. Fixes a crash/freeze that occurred
-- when importing large assets: the old code called the full-tree
-- _wireSourceChangeListeners() once per new script during import, which
-- was an O(n^2) blowup (n = place size x new script count) and froze or
-- crashed Studio on big asset imports.
function MainController:_wireSingleScriptListener(obj)
	self._trackedScripts = self._trackedScripts or {}
	if self._trackedScripts[obj] or obj:IsDescendantOf(self.Widget) then
		return
	end
	self._trackedScripts[obj] = true
	local ok, conn = pcall(function()
		return obj:GetPropertyChangedSignal("Source"):Connect(function()
			self:_scheduleRescan()
		end)
	end)
	if ok and conn then
		obj.AncestryChanged:Connect(function(_, parent)
			if parent == nil then
				conn:Disconnect()
				self._trackedScripts[obj] = nil
			end
		end)
	end
end

-- One-time full-tree pass (startup only) to wire listeners onto every
-- script that already exists. Yields periodically so a very large
-- existing place doesn't stall Studio on the initial pass either.
function MainController:_wireSourceChangeListeners()
	self._trackedScripts = self._trackedScripts or {}
	local processed = 0
	for _, obj in ipairs(game:GetDescendants()) do
		if Utils.isLuaScript(obj) then
			self:_wireSingleScriptListener(obj)
		end
		processed += 1
		if processed % 150 == 0 then
			task.wait()
		end
	end
end

function MainController:_wireLiveRescan()
	local WATCHED_SERVICES = {
		"Workspace", "ServerScriptService", "ServerStorage", "ReplicatedStorage",
		"StarterGui", "StarterPlayer", "Lighting", "SoundService",
	}

	for _, serviceName in ipairs(WATCHED_SERVICES) do
		local ok, service = pcall(game.GetService, game, serviceName)
		if ok and service then
			service.DescendantAdded:Connect(function(obj)
				if obj:IsDescendantOf(self.Widget) then return end
				self:_scheduleRescan()
				-- Newly added scripts need their own Source listener too.
				-- Wired directly onto this one object (O(1)) instead of
				-- re-walking the whole place -- see _wireSingleScriptListener.
				if Utils.isLuaScript(obj) then
					self:_wireSingleScriptListener(obj)
				end
			end)
			service.DescendantRemoving:Connect(function(obj)
				if obj:IsDescendantOf(self.Widget) then return end
				self:_scheduleRescan()
			end)
		end
	end

	-- Attach Source-change listeners to every script that already exists.
	self:_wireSourceChangeListeners()
end

return MainController
