-- Theme: all colors, fonts, and shared sizing in one place.
local Theme = {}

Theme.Color = {
	BG       = Color3.fromRGB(13,  13,  18),
	PANEL    = Color3.fromRGB(22,  22,  30),
	SURFACE  = Color3.fromRGB(30,  30,  42),
	BORDER   = Color3.fromRGB(50,  50,  68),
	TEXT     = Color3.fromRGB(225, 225, 235),
	MUTED    = Color3.fromRGB(120, 120, 150),
	DIM      = Color3.fromRGB(65,  65,  90),
	RED      = Color3.fromRGB(210, 55,  55),
	RED_DIM  = Color3.fromRGB(130, 30,  30),
	BLUE     = Color3.fromRGB(65,  130, 230),
	BLUE_DIM = Color3.fromRGB(35,  70,  140),
	GREEN    = Color3.fromRGB(55,  175, 110),
	AMBER    = Color3.fromRGB(220, 150, 40),
	PURPLE   = Color3.fromRGB(140, 80,  210),
	TEAL     = Color3.fromRGB(45,  170, 160),
}

Theme.ResultTypeColor = {
	CodeMatch = Theme.Color.RED,
	Profanity = Theme.Color.RED,
	UserId = Theme.Color.RED,
	UIText = Theme.Color.AMBER,
	Attributes = Theme.Color.PURPLE,
	Tag = Theme.Color.TEAL,
	MissingRef = Theme.Color.AMBER,
	Recognized = Theme.Color.GREEN,
	Flagged = Theme.Color.RED,
}

Theme.SeverityLabel = {
	CodeMatch = "Code Match",
	Profanity = "Profanity",
	UserId = "UserID",
	UIText = "UI Text",
	Attributes = "Attribute",
	Tag = "Tag",
	MissingRef = "Missing Ref",
	Recognized = "Recognized",
	Flagged = "Flagged",
}

return Theme
]]></ProtectedString>
