					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX84FF90FD4D604B58AC61CB2CF3645BA0">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
-- AssetSyncEngine: polls the local HE-Hub companion app and rebuilds synced
-- assets in Workspace. Originally its own standalone plugin (AssetSync);
-- now a module consumed by HE-Utilities' MainController so both tools
-- live under one toolbar/widget. Exposes Start(callbacks) where callbacks
-- is { OnStatusChange, OnDetailChange, OnScanChange } -- MainController
-- wires these to the Sync tab's labels.
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

local ScanEngine = require(script.Parent.ScopedScanEngine)

local SERVER_URL = "http://127.0.0.1:34877"
local POLL_INTERVAL = 2 -- seconds
local CONTAINER_NAME = "SyncedAssets"

local ENUM_PROPERTY_MAP = {
	Shape = Enum.PartType,
	Material = Enum.Material,
	BackSurface = Enum.SurfaceType,
	BottomSurface = Enum.SurfaceType,
	FrontSurface = Enum.SurfaceType,
	LeftSurface = Enum.SurfaceType,
	RightSurface = Enum.SurfaceType,
	TopSurface = Enum.SurfaceType,
	TextXAlignment = Enum.TextXAlignment,
	TextYAlignment = Enum.TextYAlignment,
	HorizontalAlignment = Enum.HorizontalAlignment,
	VerticalAlignment = Enum.VerticalAlignment,
	ScaleType = Enum.ScaleType,
	SizeConstraint = Enum.SizeConstraint,
	AutomaticSize = Enum.AutomaticSize,
}

local AssetSyncEngine = {}
AssetSyncEngine.__index = AssetSyncEngine

function AssetSyncEngine.new()
	local self = setmetatable({}, AssetSyncEngine)
	self.Enabled = true
	self.LastVersion = -1
	self.LastNotifiedError = nil
	self.Callbacks = { OnStatusChange = nil, OnDetailChange = nil, OnScanChange = nil, OnRemovalChange = nil }
	self.SuppressRemoval = false
	self.RemovalConnection = nil
	return self
end

local function notify(text)
	local ok = pcall(function()
		StarterGui:SetCore("SendNotification", { Title = "Asset Sync", Text = text, Duration = 4 })
	end)
	if not ok then
		print("[AssetSync] " .. text)
	end
end

local function getContainer()
	local container = Workspace:FindFirstChild(CONTAINER_NAME)
	if not container then
		container = Instance.new("Folder")
		container.Name = CONTAINER_NAME
		container.Parent = Workspace
	end
	return container
end

local function clearContainer()
	local container = getContainer()
	for _, child in ipairs(container:GetChildren()) do
		child:Destroy()
	end
end

local function urlEncodeFilename(name)
	return (name:gsub("[^%w%-%.%_%~]", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

local function enumItemFromToken(enumType, token)
	for _, item in ipairs(enumType:GetEnumItems()) do
		if item.Value == token then
			return item
		end
	end
	return nil
end

local function setProperty(instance, name, propData)
	local ptype = propData.type
	local value = propData.value

	if ptype == "string" or ptype == "bool" or ptype == "number" then
		instance[name] = value
	elseif ptype == "Content" then
		instance[name] = value
	elseif ptype == "Vector3" then
		instance[name] = Vector3.new(value.x, value.y, value.z)
	elseif ptype == "Vector2" then
		instance[name] = Vector2.new(value.x, value.y)
	elseif ptype == "Color3" then
		instance[name] = Color3.new(value.r, value.g, value.b)
	elseif ptype == "Color3uint8" then
		instance[name] = Color3.fromRGB(value.r, value.g, value.b)
	elseif ptype == "CFrame" then
		instance[name] = CFrame.new(
			value.x, value.y, value.z,
			value.r00, value.r01, value.r02,
			value.r10, value.r11, value.r12,
			value.r20, value.r21, value.r22
		)
	elseif ptype == "UDim" then
		instance[name] = UDim.new(value.s, value.o)
	elseif ptype == "UDim2" then
		instance[name] = UDim2.new(value.xs, value.xo, value.ys, value.yo)
	elseif ptype == "token" then
		local enumType = ENUM_PROPERTY_MAP[name]
		if enumType then
			local item = enumItemFromToken(enumType, value)
			if item then
				instance[name] = item
			end
		end
	end
end

local function buildTree(node, referentMap, pendingRefs)
	if not node or not node.class then
		return nil
	end

	local ok, instance = pcall(Instance.new, node.class)
	if not ok or not instance then
		warn("[AssetSync] Could not create instance of class " .. tostring(node.class) .. ": " .. tostring(instance))
		return nil
	end

	if node.referent then
		referentMap[node.referent] = instance
	end

	for name, propData in pairs(node.properties or {}) do
		if propData.type == "Ref" then
			if propData.value then
				table.insert(pendingRefs, { instance = instance, name = name, referent = propData.value })
			end
		else
			local setOk, setErr = pcall(setProperty, instance, name, propData)
			if not setOk then
				warn("[AssetSync] Could not set " .. tostring(node.class) .. "." .. tostring(name) .. ": " .. tostring(setErr))
			end
		end
	end

	for _, childNode in ipairs(node.children or {}) do
		local child = buildTree(childNode, referentMap, pendingRefs)
		if child then
			child.Parent = instance
		end
	end

	return instance
end

local function loadAssetTree(filename)
	local url = SERVER_URL .. "/asset-tree/" .. urlEncodeFilename(filename)
	local ok, response = pcall(function()
		return HttpService:RequestAsync({ Url = url, Method = "GET" })
	end)
	if not ok or not response then
		warn("[AssetSync] Failed to reach HE-Hub for asset tree: " .. tostring(response))
		return nil
	end

	local decodeOk, body = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)
	if not decodeOk or type(body) ~= "table" then
		warn("[AssetSync] Failed to decode asset-tree response for " .. filename)
		return nil
	end

	if not response.Success then
		warn("[AssetSync] HE-Hub could not provide asset tree for " .. filename .. ": " .. tostring(body.error))
		return nil
	end

	return body.roots
end

function AssetSyncEngine:_fireDetail(text, isError)
	if self.Callbacks.OnDetailChange then
		self.Callbacks.OnDetailChange(text, isError)
	end
end

function AssetSyncEngine:_fireScan(text, hadIssues)
	if self.Callbacks.OnScanChange then
		self.Callbacks.OnScanChange(text, hadIssues)
	end
end

function AssetSyncEngine:_fireStatus()
	if self.Callbacks.OnStatusChange then
		self.Callbacks.OnStatusChange(self.Enabled)
	end
end

function AssetSyncEngine:_fireRemoval(obj)
	local path = obj:GetFullName()
	local text = ("%s removed at %s"):format(obj.Name, os.date("%X"))
	notify("Synced item removed: " .. obj.Name)
	warn("[AssetSync] Descendant of synced assets was removed: " .. path)
	if self.Callbacks.OnRemovalChange then
		self.Callbacks.OnRemovalChange(text, true)
	end
end

-- Watches the synced container for anything being deleted or moved out of
-- it AFTER a sync completes (someone deleting a part in Explorer, a script
-- destroying it at runtime, etc). Deliberately does NOT fire for our own
-- clearContainer() wipes ahead of a fresh sync -- those are suppressed via
-- self.SuppressRemoval, which is set around the clear and released with
-- task.defer so it stays true through any deferred-signal removal events
-- from that same clear.
function AssetSyncEngine:_wireRemovalWatcher(container)
	if self.RemovalConnection then
		self.RemovalConnection:Disconnect()
		self.RemovalConnection = nil
	end
	self.RemovalConnection = container.DescendantRemoving:Connect(function(obj)
		if self.SuppressRemoval then
			return
		end
		self:_fireRemoval(obj)
	end)
end

function AssetSyncEngine:_scanSyncedContainer(container)
	local ok, results = pcall(ScanEngine.ScanContainer, container)
	if not ok then
		warn("[AssetSync] Scan failed: " .. tostring(results))
		self:_fireScan("scan failed", true)
		return
	end

	if #results == 0 then
		self:_fireScan("no issues found", false)
	else
		self:_fireScan(#results .. " issue(s) found", true)
		for _, r in ipairs(results) do
			warn("[AssetSync][Scan] " .. r.Type .. " match (" .. r.Count .. "x) in " .. r.Object:GetFullName())
		end
	end
end

function AssetSyncEngine:_syncFromStatus(data)
	self.SuppressRemoval = true
	clearContainer()
	task.defer(function()
		self.SuppressRemoval = false
	end)
	if not data.exists then
		return
	end

	local roots = loadAssetTree(data.filename)
	if not roots or #roots == 0 then
		notify("Failed to load asset: " .. tostring(data.filename))
		self:_fireDetail("failed to load " .. tostring(data.filename), true)
		return
	end

	local referentMap = {}
	local pendingRefs = {}
	local container = getContainer()
	self:_wireRemovalWatcher(container)

	for _, rootNode in ipairs(roots) do
		local instance = buildTree(rootNode, referentMap, pendingRefs)
		if instance then
			instance.Parent = container
		end
	end

	for _, ref in ipairs(pendingRefs) do
		local target = referentMap[ref.referent]
		if target then
			local resolveOk, resolveErr = pcall(function()
				ref.instance[ref.name] = target
			end)
			if not resolveOk then
				warn("[AssetSync] Could not resolve ref " .. ref.name .. ": " .. tostring(resolveErr))
			end
		end
	end

	notify("Loaded asset: " .. tostring(data.filename))
	self:_fireDetail("Last sync: " .. os.date("%X"), false)

	self:_scanSyncedContainer(container)
end

function AssetSyncEngine:_pollOnce()
	local HttpEnabled = HttpService.HttpEnabled
	if not HttpEnabled then
		if self.LastNotifiedError ~= "http" then
			warn("[AssetSync] HTTP requests are disabled. Enable them in Game Settings > Security.")
			self.LastNotifiedError = "http"
			self:_fireDetail("HTTP requests disabled", true)
		end
		return
	end

	local ok, response = pcall(function()
		return HttpService:RequestAsync({ Url = SERVER_URL .. "/status", Method = "GET" })
	end)
	if not ok or not response or not response.Success then
		return
	end
	self.LastNotifiedError = nil

	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(response.Body)
	end)
	if not decodeOk or type(data) ~= "table" then
		return
	end

	if data.version ~= self.LastVersion then
		self.LastVersion = data.version
		self:_syncFromStatus(data)
	end
end

function AssetSyncEngine:SetEnabled(enabled)
	self.Enabled = enabled
	self:_fireStatus()
end

function AssetSyncEngine:Start(callbacks)
	self.Callbacks = callbacks or {}
	self:_fireStatus()
	self:_fireDetail("No syncs yet", false)
	self:_fireScan("No scans yet", false)
	if self.Callbacks.OnRemovalChange then
		self.Callbacks.OnRemovalChange("No removals detected", false)
	end
	self:_wireRemovalWatcher(getContainer())

	task.spawn(function()
		while true do
			if self.Enabled then
				local ok, err = pcall(function() self:_pollOnce() end)
				if not ok then
					warn("[AssetSync] Poll error: " .. tostring(err))
				end
			end
			task.wait(POLL_INTERVAL)
		end
	end)
end

return AssetSyncEngine
]]></ProtectedString>
					<string name="ScriptGuid">{D443CDF0-D878-44F0-B9B0-D50170C1F7DC}</string>
