					<ProtectedString name="Source"><![CDATA[local root = script.Parent.Parent

local SecurityLibraryProvider =
	require(
		root.Security[
		"SecurityLibraryProvider"
		]
	)

local ProjectScanner =
	require(
		root.Scanner[
		"ProjectScanner"
		]
	)

local Test = {}


function Test.Run(testRoot)

	print("==============================")
	print("REMOTE SCANNER INTEGRATION TEST")
	print("==============================")


	-- Make sure the test root exists.

	if not testRoot then

		warn(
			"Test root was not provided."
		)

		return false

	end


	-- Get the best available security library.

	local library, source =
		SecurityLibraryProvider.GetLibrary()


	if not library then

		warn(
			"Security library unavailable."
		)

		return false

	end


	print(
		"Library source:",
		source
	)

	print(
		"Library version:",
		library.Version
	)

	print(
		"Signatures:",
		#library.Signatures
	)

	print(
		"Keywords:",
		#library.Keywords
	)


	-- Run the existing project scanner
	-- using the selected library.

	local startedAt =
		os.clock()

	local findings =
		ProjectScanner.Scan(
			testRoot,
			library
		)

	local duration =
		os.clock() - startedAt


	print()
	print("Scan complete.")

	print(
		"Findings:",
		#findings
	)

	print(
		"Duration:",
		string.format(
			"%.4f seconds",
			duration
		)
	)

	print()


	-- Display findings.

	for _, finding in ipairs(findings) do

		print("------------------------------")

		print(
			"Rule:",
			finding.RuleId
		)

		print(
			"Type:",
			finding.SourceType
		)

		print(
			"Path:",
			finding.Path
		)

		print(
			"Severity:",
			finding.Severity
		)

		print(
			"Confidence:",
			finding.Confidence
		)

		print(
			"Matched:",
			finding.MatchedText
		)

	end


	print("==============================")


	-- Controlled test expects exactly
	-- four findings.

	if #findings ~= 4 then

		warn(
			"INTEGRATION TEST FAILED: "
				.. "Expected 4 findings, got "
				.. tostring(#findings)
		)

		return false, findings

	end


	print(
		"REMOTE SCANNER INTEGRATION: PASS"
	)

	print("==============================")


	return true, findings, source

end


return Test]]></ProtectedString>
