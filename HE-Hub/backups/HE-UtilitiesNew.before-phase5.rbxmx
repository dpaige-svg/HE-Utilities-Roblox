				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local root = script.Parent

local SecurityLibrary =
	require(
		root["SecurityLibrary"]
	)

local Validator =
	require(
		root["SecurityLibraryValidator"]
	)

local RemoteLibraryLoader =
	require(
		root["RemoteLibraryLoader"]
	)

local SecurityLibraryProvider = {}


local function validateLibrary(library)

	local valid, errors =
		Validator.Validate(library)

	if valid then
		return true
	end

	return false, errors

end


function SecurityLibraryProvider.GetLibrary()

	-- First try the remote Python library.

	local remoteSuccess, remoteLibrary =
		RemoteLibraryLoader.Load()

	if remoteSuccess then

		local valid =
			validateLibrary(
				remoteLibrary
			)

		if valid then

			return remoteLibrary, "Remote"

		end

		warn(
			"[HE-Utilties v0.3] "
				.. "Remote security library "
				.. "failed validation. "
				.. "Using local fallback."
		)

	else

		warn(
			"[HE-Utilties v0.3] "
				.. "Remote security library "
				.. "could not be loaded. "
				.. "Using local fallback."
		)

	end


	-- Remote failed.
	-- Validate our known-good local library.

	local localValid, localErrors =
		validateLibrary(
			SecurityLibrary
		)

	if not localValid then

		warn(
			"[HE-Utilties v0.3] "
				.. "Local fallback library "
				.. "failed validation."
		)

		if localErrors then

			for _, message in ipairs(
				localErrors
				) do
				warn(message)
			end

		end

		return nil, "Unavailable"

	end


	return SecurityLibrary, "LocalFallback"

end


return SecurityLibraryProvider]]></ProtectedString>
