					<ProtectedString name="Source"><![CDATA[local Selection =
	game:GetService("Selection")

local FindingNavigator = {}

function FindingNavigator.GoToFinding(finding)
	if not finding then
		return false
	end

	local instance = finding.Instance

	if not instance then
		return false
	end

	if instance.Parent == nil then
		return false
	end

	Selection:Set({
		instance,
	})

	return true
end

return FindingNavigator]]></ProtectedString>
