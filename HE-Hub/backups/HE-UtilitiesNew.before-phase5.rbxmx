			<Item class="ModuleScript" referent="RBXCB477F3DE21E4D9794EEB87901C930BF">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Finding =
	require(script.Parent["Finding"])

local ScriptScanner = {}


local MAX_SOURCE_LENGTH = 500000

local SCRIPT_CLASSES = {
	Script = true,
	LocalScript = true,
	ModuleScript = true,
}


local function isScript(instance)
	return SCRIPT_CLASSES[instance.ClassName] == true
end

local function createSignatureFinding(
	instance,
	signature
)
	return Finding.new({
		RuleId = signature.Id,
		RuleName = signature.Name,

		Instance = instance,
		Path = instance:GetFullName(),

		MatchedText = signature.Pattern,

		Severity = signature.Severity,
		Confidence = signature.Confidence,
		Category = signature.Category,

		Description = signature.Description,

		SourceType = "Signature",
	})
end

local function createKeywordFinding(
	instance,
	keyword
)
	return Finding.new({
		RuleId = keyword.Id,
		RuleName = keyword.Keyword,

		Instance = instance,
		Path = instance:GetFullName(),

		MatchedText = keyword.Keyword,

		Severity = keyword.Severity,
		Confidence = keyword.Confidence,
		Category = keyword.Category,

		Description = keyword.Description,

		SourceType = "Keyword",
	})
end


function ScriptScanner.IsScript(instance)
	if not instance then
		return false
	end

	return isScript(instance)
end

function ScriptScanner.ScanInstance(
	instance,
	securityLibrary
)
	local findings = {}


	if not instance then
		return findings
	end

	if not isScript(instance) then
		return findings
	end


	if type(securityLibrary) ~= "table" then
		return findings
	end

	if type(securityLibrary.Signatures) ~= "table" then
		return findings
	end

	if type(securityLibrary.Keywords) ~= "table" then
		return findings
	end


	local success, source =
		pcall(function()
			return instance.Source
		end)

	if not success then
		return findings
	end

	if type(source) ~= "string" then
		return findings
	end


	if #source > MAX_SOURCE_LENGTH then
		warn(
			"[HE-Utilties v0.3]",
			"Skipped unusually large script:",
			instance:GetFullName(),
			"Source length:",
			#source
		)

		return findings
	end


	for _, signature in ipairs(
		securityLibrary.Signatures
		) do
		if type(signature.Pattern) == "string"
			and signature.Pattern ~= "" then

			local found =
				string.find(
					source,
					signature.Pattern,
					1,
					true
				)

			if found then
				table.insert(
					findings,
					createSignatureFinding(
						instance,
						signature
					)
				)
			end
		end
	end


	for _, keyword in ipairs(
		securityLibrary.Keywords
		) do
		if type(keyword.Keyword) == "string"
			and keyword.Keyword ~= "" then

			local found =
				string.find(
					source,
					keyword.Keyword,
					1,
					true
				)

			if found then
				table.insert(
					findings,
					createKeywordFinding(
						instance,
						keyword
					)
				)
			end
		end
	end

	return findings
end

return ScriptScanner]]></ProtectedString>
					<string name="ScriptGuid">{8E15DA63-2532-4F55-ADC3-0F8FCA6B8DBE}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">ScriptScanner</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
