					<string name="ScriptGuid">{786D8C24-4216-4888-8162-8B3B248818C8}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">SecurityLibrary</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX6FAA8BCBCD1F45BA88806C53AEE6A3C3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Validator = {}

local VALID_SEVERITIES = {
	Info = true,
	Low = true,
	Medium = true,
	High = true,
	Critical = true,
}

local VALID_CONFIDENCE = {
	Low = true,
	Medium = true,
	High = true,
	VeryHigh = true,
}

local function validateRuleId(id, knownIds, errors)
	if type(id) ~= "string" or id == "" then
		table.insert(errors, "Rule has an invalid ID.")
		return
	end

	if knownIds[id] then
		table.insert(errors, "Duplicate rule ID: " .. id)
		return
	end

	knownIds[id] = true
end

function Validator.Validate(library)
	local errors = {}

	if type(library) ~= "table" then
		return false, {
			"Security library must be a table.",
		}
	end

	if type(library.Version) ~= "string"
		or library.Version == "" then
		table.insert(
			errors,
			"Security library version is missing."
		)
	end

	if type(library.Signatures) ~= "table" then
		table.insert(errors, "Signatures are missing.")
	end

	if type(library.Keywords) ~= "table" then
		table.insert(errors, "Keywords are missing.")
	end

	if #errors > 0 then
		return false, errors
	end

	local knownIds = {}

	for _, signature in ipairs(library.Signatures) do
		validateRuleId(
			signature.Id,
			knownIds,
			errors
		)

		if type(signature.Pattern) ~= "string"
			or signature.Pattern == "" then
			table.insert(
				errors,
				(signature.Id or "Unknown signature")
					.. " has an empty pattern."
			)
		end

		if not VALID_SEVERITIES[signature.Severity] then
			table.insert(
				errors,
				(signature.Id or "Unknown signature")
					.. " has invalid severity."
			)
		end

		if not VALID_CONFIDENCE[signature.Confidence] then
			table.insert(
				errors,
				(signature.Id or "Unknown signature")
					.. " has invalid confidence."
			)
		end
	end

	for _, keyword in ipairs(library.Keywords) do
		validateRuleId(
			keyword.Id,
			knownIds,
			errors
		)

		if type(keyword.Keyword) ~= "string"
			or keyword.Keyword == "" then
			table.insert(
				errors,
				(keyword.Id or "Unknown keyword")
					.. " has an empty keyword."
			)
		end

		if not VALID_SEVERITIES[keyword.Severity] then
			table.insert(
				errors,
				(keyword.Id or "Unknown keyword")
					.. " has invalid severity."
			)
		end

		if not VALID_CONFIDENCE[keyword.Confidence] then
			table.insert(
				errors,
				(keyword.Id or "Unknown keyword")
					.. " has invalid confidence."
			)
		end
	end

	return #errors == 0, errors
end

return Validator]]></ProtectedString>
