					<ProtectedString name="Source"><![CDATA[local root =
	script.Parent.Parent

local SecurityLibrary =
	require(
		root.Security["SecurityLibrary"]
	)

local ScriptScanner =
	require(
		root.Scanner["ScriptScanner"]
	)

local AutoScanService =
	require(
		root.Scanner["AutoScanService"]
	)

local TestAutoScan = {}

function TestAutoScan.Start()

	AutoScanService.SetCallbacks({

		OnFindings =
			function(instance, findings)

				print(
					"[AUTO SCAN TEST]",
					instance:GetFullName(),
					#findings,
					"finding(s)"
				)

				for _, finding in ipairs(
					findings
					) do

					print(
						finding.RuleId,
						finding.Severity,
						finding.Confidence
					)

				end
			end,

		OnScanError =
			function(instance)

				warn(
					"[AUTO SCAN TEST]",
					"Failed:",
					instance:GetFullName()
				)

			end,

		OnQueueChanged =
			function(queueSize)

				print(
					"[AUTO SCAN TEST]",
					"Queue:",
					queueSize
				)

			end,

		OnLargeQueue =
			function(queueSize)

				warn(
					"[AUTO SCAN TEST]",
					"Large queue detected:",
					queueSize
				)

			end,
	})

	local success, errorMessage =
		AutoScanService.Start(
			workspace,
			ScriptScanner,
			SecurityLibrary
		)

	if not success then
		warn(
			"Could not start Auto Scan:",
			errorMessage
		)

		return
	end

	print(
		"[AUTO SCAN TEST]",
		"Ready. Edit or add a test Script."
	)
end

function TestAutoScan.Stop()

	AutoScanService.Stop()

end

return TestAutoScan]]></ProtectedString>
