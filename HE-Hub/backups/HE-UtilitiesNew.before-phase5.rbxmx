		root.Security["RemoteLibraryLoader"]
	)

local Validator =
	require(
		root.Security[
		"SecurityLibraryValidator"
		]
	)

local Test = {}


function Test.Run()

	print("==============================")
	print("REMOTE LIBRARY TEST")
	print("==============================")

	-- Download remote security library.

	local success, result =
		RemoteLibraryLoader.Load()

	if not success then

		warn(
			"Remote library FAILED:",
			result
		)

		return false

	end


	-- Validate downloaded library before use.

	local valid, validationErrors =
		Validator.Validate(result)

	if not valid then

		warn(
			"Remote library FAILED validation."
		)

		for _, message in ipairs(
			validationErrors
			) do
			warn(message)
		end

		return false

	end


	print(
		"Remote validation: PASS"
	)

	print(
		"Version:",
		result.Version
	)

	print(
		"Signatures:",
		#result.Signatures
	)

	print(
		"Keywords:",
		#result.Keywords
	)

	print("==============================")
	print("REMOTE LIBRARY: PASS")
	print("==============================")

	return true, result

end


return Test]]></ProtectedString>
